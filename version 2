        });
        const litTex = canvasTex(64, 64, (g, w, h) => {
            g.fillStyle = '#000';
            g.fillRect(0, 0, w, h);
            for (let r = 0; r < 4; r++)
                for (let c = 0; c < 4; c++) {
                    if (Math.random() < 0.45) {
                        g.fillStyle = Math.random() < 0.5 ? '#ffd27a' : '#cfe6ff';
                        g.fillRect(4 + c * 16, 6 + r * 16, 9, 7);
                    }
                }
        });
        [winTex, litTex].forEach(t => {
            t.wrapS = t.wrapT = THREE.RepeatWrapping;
        });
        R.bldMats = [];
        const classes = [{
            max: 4.5,
            rows: 2
        }, {
            max: 9,
            rows: 4
        }, {
            max: 16,
            rows: 7
        }, {
            max: 99,
            rows: 12
        }];
        const lots = [[], [], [], []];
        const stationPts = G.st.map(s => {
            const st3 = R.st3[s.id];
            const kp = st3.g.localToWorld(new THREE.Vector3(st3.kx, 0, st3.kz));
            return [s.x * S, s.y * S, kp.x, kp.z];
        });
        const trees = [],
            roofs = [],
            neon = [];
        for (let i = 0; i < 14; i++)
            for (let j = 0; j < 14; j++) {
                const cx = -32.5 + 5 * i,
                    cz = -32.5 + 5 * j;
                if (stationPts.some(p => Math.hypot(p[0] - cx, p[1] - cz) < 5.2 || Math.hypot(p[2] - cx, p[3] - cz) < 4.8)) {
                    if (Math.random() < 0.15)
                        trees.push([cx + rnd(-1.5, 1.5), cz + rnd(-1.5, 1.5)]);
                    continue;
                }
                if (keep.some(k => Math.hypot(k[0] - cx, k[1] - cz) < k[2] + 2))
                    continue;
                if (isWater(cx, cz))
                    continue;
                if (G.city.key === 'cairo' && cx < -0.62 * S && cz > 0.3 * S) {
                    continue;
                }
                if (Math.random() < 0.08) {
                    for (let t = 0; t < 3; t++)
                        trees.push([cx + rnd(-1.8, 1.8), cz + rnd(-1.8, 1.8)]);
                    continue;
                }
                const center = 1 - Math.min(1, Math.hypot(cx, cz) / 40);
                let h = T.h[0] + (T.h[1] - T.h[0]) * Math.pow(Math.random(), 2.4 - center * 1.2);
                if (Math.random() < T.tall * center)
                    h = T.h[1] * rnd(1, 1.35);
                const near = Math.min(...stationPts.map(p => Math.min(Math.hypot(p[0] - cx, p[1] - cz), Math.hypot(p[2] - cx, p[3] - cz))));
                if (near < 9)
                    h = Math.min(h, T.h[0] + 1);
                else if (near < 13)
                    h = Math.min(h, T.h[0] + 4);
                const sub = Math.random() < 0.35 ? 2 : 1;
                for (let q = 0; q < sub; q++) {
                    const w = sub === 2 ? rnd(1.5, 1.8) : rnd(2.6, 3.7),
                        d = rnd(2.4, 3.6),
                        hh = sub === 2 ? h * rnd(0.6, 1) : h;
                    const ox = sub === 2 ? (q ? 1 : -1) * 0.95 : 0;
                    const ci = classes.findIndex(c => hh <= c.max);
                    lots[ci].push({
                        x: cx + ox,
                        z: cz,
                        w,
                        d,
                        h: hh,
                        col: T.bld[Math.floor(Math.random() * T.bld.length)]
                    });
                    if (hh > 6 && Math.random() < 0.5)
                        roofs.push([cx + ox + rnd(-0.4, 0.4), hh, cz + rnd(-0.6, 0.6)]);
                    if (T.neon && Math.random() < 0.35)
                        neon.push([cx + ox, hh, cz, w, d]);
                }
                if (Math.random() < 0.15)
                    trees.push([cx + 2.2, cz + rnd(-2, 2)]);
            }
        R.bldMeshes = [];
        classes.forEach((cl, ci) => {
            if (!lots[ci].length)
                return;
            const geo = new THREE.BoxGeometry(1, 1, 1);
            geo.translate(0, 0.5, 0);
            const uv = geo.attributes.uv;
            for (let f = 0; f < 6; f++)
                for (let v = 0; v < 4; v++) {
                    const i = f * 4 + v;
                    if (f === 2 || f === 3)
                        uv.setXY(i, 0.5, 0.99);
                    else
                        uv.setXY(i, uv.getX(i) * 3, uv.getY(i) * cl.rows);
                }
            const m = new THREE.MeshStandardMaterial({
                map: winTex,
                emissiveMap: litTex,
                emissive: '#ffffff',
                emissiveIntensity: T.glow,
                roughness: 0.75
            });
            R.bldMats.push(m);
            const im = new THREE.InstancedMesh(geo, m, lots[ci].length);
            im.castShadow = true;
            im.receiveShadow = true;
            lots[ci].forEach((b, i) => {
                tmpM.compose(tmpV.set(b.x, 0, b.z), tmpQ.setFromEuler(tmpE.set(0, 0, 0)), tmpS.set(b.w, b.h, b.d));
                im.setMatrixAt(i, tmpM);
                im.setColorAt(i, tmpC.set(b.col));
            });
            im.renderOrder = 20;
            world.add(im);
            R.bldMeshes.push(im);
        });
        if (roofs.length) {
            const m = mat('#9aa0a6');
            R.bldMats.push(m);
            const im = new THREE.InstancedMesh(new THREE.BoxGeometry(0.8, 0.6, 0.8), m, roofs.length);
            roofs.forEach((r, i) => {
                tmpM.compose(tmpV.set(r[0], r[1] + 0.3, r[2]), tmpQ.identity(), tmpS.set(1, 1, 1));
                im.setMatrixAt(i, tmpM);
            });
            im.renderOrder = 20;
            world.add(im);
            R.bldMeshes.push(im);
        }
        if (neon.length) {
            const m = new THREE.MeshBasicMaterial({
                transparent: true,
                opacity: 1
            });
            R.bldMats.push(m);
            const im = new THREE.InstancedMesh(new THREE.BoxGeometry(1, 1, 1), m, neon.length);
            const nc = ['#ff3d9a', '#33e1ff', '#ffe14a', '#7cff6b', '#ff7a2f'];
            neon.forEach((n, i) => {
                tmpM.compose(tmpV.set(n[0], n[1] * rnd(0.45, 0.8), n[2] + n[4] / 2 + 0.06), tmpQ.identity(), tmpS.set(n[3] * 0.6, rnd(0.8, 1.8), 0.1));
                im.setMatrixAt(i, tmpM);
                im.setColorAt(i, tmpC.set(nc[i % nc.length]));
            });
            im.renderOrder = 20;
            world.add(im);
            R.bldMeshes.push(im);
        }
        // trees
        const palms = T.palms;
        const trunk = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.12, 0.16, palms ? 2.6 : 1.1, 6), mat('#6b4a2f'), trees.length);
        const crown = new THREE.InstancedMesh(palms ? new THREE.SphereGeometry(0.9, 8, 5) : new THREE.IcosahedronGeometry(0.95, 0), mat(T.tree, {
            flatShading: true
        }), trees.length);
        trunk.castShadow = crown.castShadow = true;
        R.trees = trees.map(t => ({
            x: t[0],
            z: t[1],
            s: rnd(0.8, 1.3),
            ph: Math.random() * 6
        })).filter(t => Math.abs(t.x) < HALF - 1 && Math.abs(t.z) < HALF - 1 && !isWater(t.x, t.z));
        trunk.count = crown.count = R.trees.length;
        R.trunk = trunk;
        R.crown = crown;
        world.add(trunk, crown);
        R.treeH = palms ? 2.6 : 1.1;
        R.palms = palms;
        placeTrees(0);
    }
    function placeTrees(sway) {
        R.trees.forEach((t, i) => {
            const lean = sway ? Math.sin(R.t * 3 + t.ph) * sway : 0;
            tmpQ.setFromEuler(tmpE.set(lean * 0.4, 0, lean));
            tmpM.compose(tmpV.set(t.x, R.treeH / 2 * t.s, t.z), tmpQ, tmpS.set(t.s, t.s, t.s));
            R.trunk.setMatrixAt(i, tmpM);
            const top = R.treeH * t.s + (R.palms ? 0.2 : 0.7) * t.s;
            tmpM.compose(tmpV.set(t.x + lean * top * 0.8, top, t.z - lean * top * 0.3), tmpQ, tmpS.set(t.s, R.palms ? t.s * 0.45 : t.s * 1.1, t.s));
            R.crown.setMatrixAt(i, tmpM);
        });
        R.trunk.instanceMatrix.needsUpdate = true;
        R.crown.instanceMatrix.needsUpdate = true;
    }
    function buildCars(world) {
        const lanes = [];
        for (let i = 1; i < 14; i++) {
            const c = -35 + 5 * i;
            for (const axis of ['x', 'z']) {
                let ok = true;
                for (let t = -34; t <= 34; t += 3) {
                    const [x, z] = axis === 'x' ? [t, c] : [c, t];
                    if (isWater(x, z)) {
                        ok = false;
                        break;
                    }
                }
                if (ok)
                    lanes.push({
                        axis,
                        c
                    });
            }
        }
        const n = Math.min(34, lanes.length * 3);
        const cols = ['#d52a3f', '#f4f4f4', '#1c5d99', '#2b2b2b', '#f2c230', '#9aa0a6', '#2e9e6b'];
        const im = new THREE.InstancedMesh(new THREE.BoxGeometry(0.7, 0.5, 1.3), mat('#ffffff', {
            metalness: 0.3,
            roughness: 0.4
        }), Math.max(1, n));
        im.castShadow = true;
        R.cars = [];
        for (let i = 0; i < n && lanes.length; i++) {
            const L = lanes[Math.floor(Math.random() * lanes.length)],
                dir = Math.random() < 0.5 ? 1 : -1;
            R.cars.push({
                axis: L.axis,
                c: L.c + dir * 0.45,
                p: rnd(-34, 34),
                dir,
                v: rnd(4, 7)
            });
            im.setColorAt(i, tmpC.set(cols[i % cols.length]));
        }
        im.count = R.cars.length;
        R.carMesh = im;
        world.add(im);
    }
    function buildWeather(world, key) {
        const N = 2200,
            pos = new Float32Array(N * 6);
        R.drops = [];
        for (let i = 0; i < N; i++)
            R.drops.push([rnd(-40, 40), rnd(0, 42), rnd(-40, 40)]);
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        R.rain = new THREE.LineSegments(geo, new THREE.LineBasicMaterial({
            color: '#c7dcec',
            transparent: true,
            opacity: 0.55,
            depthWrite: false
        }));
        R.rain.frustumCulled = false;
        R.rain.renderOrder = 30;
        world.add(R.rain);
        R.clouds = [];
        if (key === 'tokyo' || key === 'nyc') {
            const cm = new THREE.MeshStandardMaterial({
                color: '#e9eef2',
                roughness: 1,
                transparent: true,
                opacity: 0.92,
                flatShading: true
            });
            R.cloudMat = cm;
            for (let i = 0; i < 9; i++) {
                const c = new THREE.Group(),
                    a = i / 9 * Math.PI * 2,
                    r = rnd(95, 120);
                for (let k = 0; k < 5; k++) {
                    const p = new THREE.Mesh(new THREE.IcosahedronGeometry(rnd(3, 5.5), 0), cm);
                    p.position.set(rnd(-5, 5), rnd(-1, 1.5), rnd(-3, 3));
                    p.scale.y = 0.6;
                    c.add(p);
                }
                c.position.set(Math.cos(a) * r, rnd(30, 42), Math.sin(a) * r);
                c.scale.setScalar(1.8);
                c.userData = {
                    a,
                    r
                };
                world.add(c);
                R.clouds.push(c);
            }
        }
        R.sunDisk = null;
        if (key === 'london' || key === 'cairo' || key === 'mexico') {
            const sm = new THREE.SpriteMaterial({
                map: R.texSoft,
                color: key === 'london' ? '#ffd27a' : '#fff1c9',
                transparent: true,
                depthWrite: false,
                fog: false
            });
            const sp = new THREE.Sprite(sm);
            sp.position.copy(R.sun.position).multiplyScalar(3.2);
            sp.scale.set(70, 70, 1);
            world.add(sp);
            R.sunDisk = sp;
        }
    }
    function buildParticles(world) {
        R.pool = [];
        for (let i = 0; i < 280; i++) {
            const sp = new THREE.Sprite(new THREE.SpriteMaterial({
                map: R.texSoft,
                transparent: true,
                depthWrite: false
            }));
            sp.visible = false;
            sp.renderOrder = 25;
            world.add(sp);
            R.pool.push({
                sp,
                life: 0,
                age: 0,
                v: new THREE.Vector3(),
                s0: 1,
                s1: 1,
                op: 1
            });
        }
        R.poolI = 0;
    }
    function emit(x, y, z, vx, vy, vz, life, s0, s1, color, op) {
        const p = R.pool[R.poolI = (R.poolI + 1) % R.pool.length];
        p.sp.position.set(x, y, z);
        p.v.set(vx, vy, vz);
        p.life = life;
        p.age = 0;
        p.s0 = s0;
        p.s1 = s1;
        p.op = op;
        p.sp.material.color.set(color);
        p.sp.visible = true;
    }
    function setXray(on) {
        R.xray = on;
        if (!R.world)
            return;
        R.groundMat.opacity = on ? 0.2 : 1;
        R.groundMat.depthWrite = !on;
        R.groundMat.needsUpdate = true;
        for (const m of [...(R.bldMats || []), ...(R.lmMats || []), R.trunk.material, R.crown.material]) {
            m.transparent = on;
            m.opacity = on ? 0.1 : 1;
            m.depthWrite = !on;
            m.needsUpdate = true;
        }
        R.waterMat.opacity = on ? 0.4 : 0.88;
        for (const o of [...(R.bldMeshes || []), R.landmark, R.trunk, R.crown, R.carMesh])
            if (o)
                o.visible = !on;
        const b = $('#btnXray');
        if (b)
            b.setAttribute('aria-pressed', on);
    }

    // ---------- Per-frame visuals ----------
    function visuals(dt) {
        if (!R.world || !G)
            return;
        R.t += dt;
        const C = G.city,
            T = R.T,
            t = R.t,
            live = G.phase === 'run' && !G.paused;
        const simDt = live ? dt * G.speed : 0;
        // weather intensity
        let storm = 0;
        if (C.key === 'tokyo')
            storm = clamp((G.wind - 25) / 85, 0, 1);
        else if (C.key === 'nyc')
            storm = clamp((G.rain - 25) / 31, 0, 1);
        else if (C.key === 'london')
            storm = clamp((G.amb - 29) / 6.5, 0, 1);
        else if (C.key === 'mexico')
            storm = clamp((G.mmi - 2) / 5, 0, 1);
        else
            storm = clamp((G.dem - 1) / 0.5, 0, 1);
        R.storm += (storm - R.storm) * Math.min(1, dt * 1.5);
        const sky = tmpC.set(T.sky[0]).lerp(new THREE.Color(T.sky[1]), R.storm);
        if (R.lightning > 0) {
            R.lightning -= dt;
            sky.lerp(new THREE.Color('#ffffff'), 0.6);
        }
        R.scene.background = sky.clone();
        R.scene.fog.color.copy(sky);
        document.body.style.background = '#' + sky.getHexString();
        const wet = C.key === 'tokyo' || C.key === 'nyc';
        R.sun.intensity = wet ? 0.95 - R.storm * 0.55 : C.key === 'london' ? 0.9 + R.storm * 0.35 : 0.95;
        R.sun.color.set(C.key === 'london' ? '#fff0d6' : C.key === 'cairo' ? '#ffe7c2' : '#ffffff');
        R.hemi.intensity = (wet ? 0.75 - R.storm * 0.25 : 0.75) + (R.lightning > 0 ? 1.4 : 0);
        if (wet && R.storm > 0.75 && live && Math.random() < dt * 0.35 * G.speed) {
            R.lightning = 0.12;
            const f = $('#flash');
            f.style.transition = 'none';
            f.style.opacity = 0.35;
            requestAnimationFrame(() => {
                f.style.transition = 'opacity .4s';
                f.style.opacity = 0;
            });
        }
        for (const m of R.bldMats || [])
            if (m.emissiveMap)
                m.emissiveIntensity = T.glow + (wet ? R.storm * 0.4 : 0);
        if (R.cloudMat)
            R.cloudMat.color.set('#e9eef2').lerp(new THREE.Color('#4a535d'), R.storm);
        R.clouds.forEach(c => {
            c.userData.a += dt * (0.01 + R.storm * 0.05);
            c.position.x = Math.cos(c.userData.a) * c.userData.r;
            c.position.z = Math.sin(c.userData.a) * c.userData.r;
        });
        if (R.sunDisk)
            R.sunDisk.scale.setScalar(C.key === 'london' ? 70 + R.storm * 50 : 70);
        // rain
        const rainK = C.key === 'nyc' ? clamp((G.rain - 15) / 40, 0, 1) : C.key === 'tokyo' ? clamp((G.rainT - 5) / 55, 0, 1) : 0;
        const nDrops = Math.round(rainK * R.drops.length);
        R.rain.visible = nDrops > 0;
        if (nDrops) {
            const windX = C.key === 'tokyo' ? G.wind * 0.12 : 2,
                arr = R.rain.geometry.attributes.position.array;
            for (let i = 0; i < nDrops; i++) {
                const d = R.drops[i];
                d[1] -= 34 * dt;
                d[0] += windX * dt;
                if (d[1] < 0) {
                    d[1] = rnd(30, 42);
                    d[0] = rnd(-44, 36);
                    d[2] = rnd(-40, 40);
                }
                const j = i * 6;
                arr[j] = d[0];
                arr[j + 1] = d[1];
                arr[j + 2] = d[2];
                arr[j + 3] = d[0] + windX * 0.03;
                arr[j + 4] = d[1] + 0.9;
                arr[j + 5] = d[2];
            }
            R.rain.geometry.setDrawRange(0, nDrops * 2);
            R.rain.geometry.attributes.position.needsUpdate = true;
            R.rain.material.opacity = 0.35 + rainK * 0.35;
        }
        // tunnels
        G.lines.forEach((L, li) => {
            const m = R.coreMats[li];
            m.emissiveIntensity = L.blocked ? (Math.sin(t * 6) > 0 ? 0.9 : 0.05) : L.slow ? 0.45 : 0.85;
            m.color.set(L.blocked ? '#555b61' : L.color);
            if (C.key === 'nyc') {
                const wmax = Math.max(...L.stops.map(i => G.st[i].w));
                R.glassMats[li].color.set(L.color).lerp(new THREE.Color('#2f78b8'), clamp(wmax / 15, 0, 1));
                R.glassMats[li].opacity = 0.24 + clamp(wmax / 15, 0, 1) * 0.25;
            }
        });
        // trains
        for (const L of G.lines)
            for (const tr of L.trains) {
                const m = tr._m || trainMesh(L, tr);
                placeTrain(m);
            }
        for (const m of R.trainMeshes) {
            m.L._mats.win.emissiveIntensity = m.L.blocked ? 0.05 : 0.35;
        }
        // stations
        const blink = Math.sin(t * 8) > 0;
        for (const st3 of R.st3) {
            const s = st3.s,
                dl = s.danger >= 60 ? 2 : s.danger >= 35 ? 1 : 0;
            st3.ringMat.color.copy(s.closed ? new THREE.Color('#7a838c') : DANGER_COL[dl]);
            st3.ringMat.opacity = dl === 2 ? 0.55 + 0.4 * Math.abs(Math.sin(t * 4)) : 0.8;
            const pulse = dl === 2 ? 1 + 0.08 * Math.sin(t * 6) : 1;
            st3.ring.scale.set(pulse, pulse, 1);
            // hall lighting
            let lc = tmpC.set('#fff4dc');
            if (C.key === 'london') {
                const k = clamp((s.temp - 30) / 6, 0, 1);
                lc.lerp(new THREE.Color('#ff8a2a'), Math.min(1, k * 1.4)).lerp(new THREE.Color('#ff3a2a'), Math.max(0, k - 0.6) * 2);
            }
            if (s.closed)
                lc.set('#59606a');
            st3.lightMat.color.copy(lc);
            st3.lightMat.emissive.copy(lc);
            st3.lightMat.emissiveIntensity = s.closed ? 0.25 : 1;
            st3.shellMat.color.copy(C.key === 'london' ? lc : tmpC.set(s.danger >= 60 ? '#ffb3b3' : '#d6ecff'));
            st3.signMat.emissiveIntensity = s.closed ? 0 : 0.7;
            st3.signMat.color.set(s.closed ? '#6b737b' : '#ffffff');
            st3.gate.visible = s.closed;
            st3.beam.visible = st3.hallBeam.visible = selId === s.id;
            if (selId === s.id) {
                st3.beam.material.opacity = 0.22 + 0.12 * Math.sin(t * 3);
                st3.beam.rotation.y += dt;
            }
            if (C.key === 'nyc') {
                const h = clamp(s.w / 15, 0, 1.3) * 1.75;
                st3.flood.visible = h > 0.05;
                st3.flood.scale.y = Math.max(0.01, h);
                st3.flood.position.y = -0.45 + h / 2;
            }
            if (C.key === 'mexico' && G.quaked) {
                const tilt = clamp((95 - s.cond) / 95, 0, 1) * 0.12;
                st3.kiosk.rotation.z = tilt * Math.sin(st3.wobble);
                st3.kiosk.rotation.x = tilt * Math.cos(st3.wobble) * 0.6;
            }
            st3.haz.visible = s.issue === 'breakdown' && blink;
            st3.sigMat.color.set(s.issue === 'signal' ? (blink ? '#ff3040' : '#f2b528') : '#2fbf6a');
            // crowds
            const nOn = Math.round(clamp(s.occ / 1.3, 0, 1) * 40);
            const nOut = s.closed ? Math.round(clamp(s.occ * 2.2 + (s.occ > 0.02 ? 0.25 : 0), 0, 1) * 24) : Math.round(clamp((s.occ - 0.85) / 0.4, 0, 1) * 24);
            setPeople(st3, nOn, nOut);
            syncDeployables(st3);
            // emitters
            st3.emit += dt;
            if (st3.emit > 0.12) {
                st3.emit = 0;
                const kp = st3.g.localToWorld(tmpV.set(st3.kx, 0, st3.kz)).clone();
                if (s.issue === 'breakdown')
                    emit(kp.x + rnd(-0.5, 0.5), 2, kp.z + rnd(-0.5, 0.5), rnd(-0.3, 0.3), 2.2, rnd(-0.3, 0.3), 2.4, 1.2, 3.5, '#4a4f55', 0.65);
                if (s.cond < 60 && live)
                    emit(kp.x + rnd(-2, 2), 0.6, kp.z + rnd(-2, 2), 0, 1.4, 0, 2.5, 1, 3, C.key === 'mexico' ? '#a08a6a' : '#7a7f86', 0.45);
                if (C.key === 'london' && s.temp > 32 && Math.random() < (s.temp - 32) / 4)
                    emit(kp.x + rnd(-2.5, 2.5), 0.4, kp.z + rnd(-2.5, 2.5), 0, 2, 0, 1.6, 0.6, 2.2, '#ff9a4a', 0.35);
                if (C.key === 'nyc' && s.item && Math.random() < 0.6)
                    emit(kp.x + rnd(-4, 4), 1.6, kp.z + rnd(-4, 4), 0, 3, 0, 0.8, 0.4, 1.4, '#a9d8ff', 0.6);
                if (C.key === 'london' && s.item && Math.random() < 0.5)
                    emit(kp.x + rnd(-4, 4), 1.2, kp.z + rnd(-4, 4), 0, 0.6, 0, 1.5, 0.6, 2, '#d8f1ff', 0.5);
            }
            // label anchor
            st3.g.localToWorld(st3.anchor.set(st3.kx, 3.6, st3.kz));
        }
        // deployable animations (blinking beacons, spinning parts)
        R.world.traverse(o => {
            if (o.userData.blink)
                o.material.color.set(Math.sin(t * 10 + (o.userData.phase ? Math.PI : 0)) > 0 ? o.userData.blink : '#222222');
            if (o.userData.spin)
                o.rotation.y += o.userData.spin * dt;
        });
        if (R.spinner) {
            if (R.spinner.axis === 'z')
                R.spinner.obj.rotation.z += R.spinner.speed * dt;
            else
                R.spinner.obj.rotation.y = Math.sin(t * 2) * 0.25 + (C.key === 'mexico' ? 0 : 0);
        }
        // transients
        R.trans = R.trans.filter(x => {
            if (R.t > x.until) {
                x.parent.remove(x.obj);
                disposeObj(x.obj);
                return false;
            }
            if (Math.random() < 0.3) {
                const p = x.obj.getWorldPosition(new THREE.Vector3());
                emit(p.x + rnd(-0.8, 0.8), 0.6, p.z + rnd(-0.8, 0.8), rnd(-1, 1), 2.5, rnd(-1, 1), 0.4, 0.25, 0.1, '#ffd34a', 1);
            }
            return true;
        });
        // weather particles
        if (C.key === 'tokyo' && G.wind > 55 && Math.random() < (G.wind - 55) / 40)
            emit(rnd(-40, 20), rnd(1, 10), rnd(-34, 34), G.wind * 0.18, rnd(-0.5, 1.2), rnd(-2, 2), 3, 0.35, 0.3, Math.random() < 0.5 ? '#7a9a4a' : '#9a7a4a', 0.9);
        if (C.key === 'cairo' && Math.random() < 0.15)
            emit(rnd(-36, 36), rnd(0.5, 4), rnd(-36, 36), 1.2, 0.2, 0, 4, 2, 5, '#e8cf9e', 0.25);
        if (C.key === 'mexico' && G.mmi > 4.2 && Math.random() < (G.mmi - 4) / 2)
            emit(rnd(-30, 30), 0.5, rnd(-30, 30), rnd(-1, 1), 1.5, rnd(-1, 1), 3, 1.5, 5, '#b8a585', 0.5);
        for (const p of R.pool) {
            if (!p.sp.visible)
                continue;
            p.age += dt;
            if (p.age >= p.life) {
                p.sp.visible = false;
                continue;
            }
            const k = p.age / p.life;
            p.sp.position.addScaledVector(p.v, dt);
            const sc = p.s0 + (p.s1 - p.s0) * k;
            p.sp.scale.set(sc, sc, 1);
            p.sp.material.opacity = p.op * (1 - k);
        }
        // cars
        const carSpeed = (C.key === 'mexico' && G.quaked && G.mmi > 3.6) ? 0 : (C.key === 'tokyo' ? 1 - R.storm * 0.6 : 1);
        R.cars.forEach((c, i) => {
            c.p += c.dir * c.v * carSpeed * dt;
            if (c.p > 35)
                c.p = -35;
            if (c.p < -35)
                c.p = 35;
            const [x, z] = c.axis === 'x' ? [c.p, c.c] : [c.c, c.p];
            tmpQ.setFromEuler(tmpE.set(0, c.axis === 'x' ? Math.PI / 2 : 0, 0));
            tmpM.compose(tmpV.set(x, 0.3, z), tmpQ, tmpS.set(1, 1, 1));
            R.carMesh.setMatrixAt(i, tmpM);
        });
        R.carMesh.instanceMatrix.needsUpdate = true;
        if (C.key === 'tokyo' && G.wind > 40)
            placeTrees(clamp((G.wind - 40) / 70, 0, 1) * 0.35);
        else if (C.key === 'mexico' && G.mmi > 3.5)
            placeTrees(clamp((G.mmi - 3.5) / 3, 0, 1) * 0.15);
        // quake shake
        const shake = C.key === 'mexico' ? Math.max(0, G.mmi - 3.2) * 0.22 : 0;
        R.world.position.set(shake ? rnd(-shake, shake) : 0, shake ? rnd(-shake, shake) * 0.4 : 0, shake ? rnd(-shake, shake) : 0);
        updateCamera(dt);
        positionLabels();
    }

    // ---------- Camera ----------
    function updateCamera(dt) {
        const c = R.cam;
        if (R.follow && R.follow._m) {
            const p = R.follow._m.cars[0].position;
            c.goal = new THREE.Vector3(p.x, p.y, p.z);
        }
        if (c.goal) {
            c.target.lerp(c.goal, 1 - Math.exp(-dt * 4));
            if (!R.follow && c.target.distanceTo(c.goal) < 0.05)
                c.goal = null;
        }
        if (c.rGoal) {
            c.r += (c.rGoal - c.r) * (1 - Math.exp(-dt * 3));
            if (Math.abs(c.r - c.rGoal) < 0.1)
                c.rGoal = null;
        }
        if (!inGame)
            c.theta += dt * 0.04;
        const sp = Math.sin(c.phi);
        R.camera.position.set(c.target.x + c.r * sp * Math.sin(c.theta), c.target.y + c.r * Math.cos(c.phi), c.target.z + c.r * sp * Math.cos(c.theta));
        R.camera.lookAt(c.target);
    }
    function resetCamera() {
        R.follow = null;
        Object.assign(R.cam, {
            goal: new THREE.Vector3(0, -1, 0),
            rGoal: 86,
            theta: 0.6,
            phi: 0.9
        });
    }
    function focusOn(v, r) {

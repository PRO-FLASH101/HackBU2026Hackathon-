    }
    function positionLabels() {
        const w = innerWidth,
            h = innerHeight,
            v = new THREE.Vector3();
        for (const st3 of R.st3) {
            v.copy(st3.anchor).project(R.camera);
            const vis = v.z < 1 && Math.abs(v.x) < 1.2 && Math.abs(v.y) < 1.2;
            st3.lbl.style.display = vis ? '' : 'none';
            if (vis)
                st3.lbl.style.transform = `translate(${(v.x + 1) / 2 * w}px, ${(1 - v.y) / 2 * h}px) translate(-50%, -100%)`;
        }
    }
    function bindCamera() {
        const cv = $('#c3d'),
            ptrs = new Map();
        let moved = 0,
            pinch = null,
            btn = 0;
        cv.addEventListener('contextmenu', e => e.preventDefault());
        cv.addEventListener('pointerdown', e => {
            cv.setPointerCapture(e.pointerId);
            ptrs.set(e.pointerId, [e.clientX, e.clientY]);
            moved = 0;
            btn = e.button;
            if (ptrs.size === 2) {
                const [a, b] = [...ptrs.values()];
                pinch = {
                    d: Math.hypot(a[0] - b[0], a[1] - b[1]),
                    r: R.cam.r,
                    mid: [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]
                };
            }
        });
        cv.addEventListener('pointermove', e => {
            if (!ptrs.has(e.pointerId))
                return;
            const prev = ptrs.get(e.pointerId);
            ptrs.set(e.pointerId, [e.clientX, e.clientY]);
            const dx = e.clientX - prev[0],
                dy = e.clientY - prev[1];
            moved += Math.abs(dx) + Math.abs(dy);
            if (moved < 4)
                return;
            cv.classList.add('dragging');
            R.cam.goal = null;
            R.cam.rGoal = null;
            R.follow = null;
            if (ptrs.size === 2 && pinch) {
                const [a, b] = [...ptrs.values()];
                R.cam.r = clamp(pinch.r * pinch.d / (Math.hypot(a[0] - b[0], a[1] - b[1]) || 1), 18, 150);
                const mid = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
                pan(mid[0] - pinch.mid[0], mid[1] - pinch.mid[1]);
                pinch.mid = mid;
                return;
            }
            if (btn === 2 || e.shiftKey)
                pan(dx, dy);
            else {
                R.cam.theta -= dx * 0.006;
                R.cam.phi = clamp(R.cam.phi - dy * 0.005, 0.2, 1.42);
            }
        });
        const up = e => {
            if (!ptrs.has(e.pointerId))
                return;
            ptrs.delete(e.pointerId);
            if (ptrs.size < 2)
                pinch = null;
            cv.classList.remove('dragging');
            if (moved < 5 && inGame)
                pickAt(e.clientX, e.clientY);
        };
        cv.addEventListener('pointerup', up);
        cv.addEventListener('pointercancel', up);
        cv.addEventListener('wheel', e => {
            e.preventDefault();
            R.cam.rGoal = null;
            R.cam.r = clamp(R.cam.r * Math.exp(e.deltaY * 0.0012), 18, 150);
        }, {
            passive: false
        });
    }
    function pan(dx, dy) {
        const c = R.cam,
            k = c.r * 0.0018;
        const rx = Math.cos(c.theta),
            rz = -Math.sin(c.theta),
            fx = -Math.sin(c.theta),
            fz = -Math.cos(c.theta);
        c.target.x = clamp(c.target.x - (dx * rx - dy * fx) * k, -HALF, HALF);
        c.target.z = clamp(c.target.z - (dx * rz - dy * fz) * k, -HALF, HALF);
    }
    function pickAt(x, y) {
        const ray = new THREE.Raycaster(),
            m = new THREE.Vector2(x / innerWidth * 2 - 1, -(y / innerHeight) * 2 + 1);
        ray.setFromCamera(m, R.camera);
        const hits = ray.intersectObjects(R.pick, false);
        const tr = hits.find(h => h.object.userData.kind === 'train'),
            st = hits.find(h => h.object.userData.kind === 'station');
        if (tr && (!st || tr.distance < st.distance + 2))
            selectTrain(tr.object.userData.L, tr.object.userData.tr);
        else if (st)
            selectStation(st.object.userData.id, false);
        else {
            selId = null;
            selTrain = null;
            buildSelCard();
        }
    }


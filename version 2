    function disposeObj(o) {
        o.traverse(n => {
            if (n.geometry)
                n.geometry.dispose();
            if (n.material)
                (Array.isArray(n.material) ? n.material : [n.material]).forEach(m => {
                    for (const k of ['map', 'emissiveMap'])
                        if (m[k] && m[k] !== R.texSoft)
                            m[k].dispose();
                    m.dispose();
                });
        });
    }

    function updateControls() {
        const C = G.city;
        if (C.controls === 'service') {
            $('#svcText').textContent = G.suspended ? 'Suspended. Passengers are stranded until you restore service.' : 'Running. Trains on exposed track take damage when gusts pass 65 km/h.';
            $('#svcBtn').textContent = G.suspended ? 'Restore service' : 'Suspend all service';

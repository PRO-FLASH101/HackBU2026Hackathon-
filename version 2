    // ---------- AI card ----------
    function renderAI() {
        const el = $('#aiCard'),
            mode = G.mode,
            mname = MODES.find(m => m.key === mode).name;
        const head = `<div class="head"><h3>🤖 AI co-pilot</h3><span class="mode">${mname} mode</span></div>`;
        if (mode === 'extreme') {
            if (aiSig !== 'x') {
                aiSig = 'x';
                el.innerHTML = `<div class="head"><h3>AI co-pilot offline</h3><span class="mode">Extreme mode</span></div><p class="sub">No forecasts, no warnings, no advice. Watch the meters, station rings and the city itself.</p>`;
            }
            return;
        }
        if (mode === 'hard') {
            const p = getPredictions(),
                sig = 'h' + p.map(x => x.text).join('|');
            if (sig !== aiSig) {
                aiSig = sig;
                el.innerHTML = head + `<p class="sub">Forecasts and live data. Decisions are yours.</p><ul class="preds">${p.map(x => `<li><span class="${statusCls(x.sev)}"></span><span>${x.text}</span></li>`).join('') || '<li>No notable changes forecast.</li>'}</ul>`;
            }
            return;
        }
        if (mode === 'easy') {
            const a = getAdvice(),
                sig = 'e' + a.map(x => x.text).join('|');
            if (sig !== aiSig) {
                aiSig = sig;
                el.innerHTML = head + `<p class="sub">${G.city.aiRole}</p>` + recList(a);
                bindRecs(el, a);
            }
            else
                el.querySelectorAll('.recs li p').forEach((p, i) => {
                    if (a[i])
                        p.textContent = a[i].why;
                });
            return;
        }
        const warn = G.st.filter(s => s.danger >= 35).length,
            crit = G.st.filter(s => s.danger >= 60).length;
        const mon = crit ? `${crit} station${crit > 1 ? 's' : ''} in high danger, ${warn - crit} more elevated.` : warn ? `${warn} station${warn > 1 ? 's' : ''} with elevated danger.` : 'All stations look stable right now.';
        const sig = 'n' + mon + (aiSnap ? aiSnap.t : '');
        if (sig === aiSig)
            return;
        aiSig = sig;
        el.innerHTML = head + `<p class="sub">Monitoring: ${mon}</p>` + (aiSnap ? `<p class="note">Advice from ${fmtT(aiSnap.t)} in:</p>` + recList(aiSnap.a) : '') + `<button class="secondary wide" id="askAI">${aiSnap ? 'Ask again' : 'Ask AI for advice'}</button>`;
        $('#askAI').onclick = () => {
            aiSnap = {
                t: G.t,
                a: getAdvice()
            };
            aiSig = '';
            renderAI();
        };
        if (aiSnap)
            bindRecs(el, aiSnap.a);
    }
    function recList(a) {
        if (!a.length)
            return `<ul class="recs"><li><b>No action needed right now</b><p>Keep an eye on the meters and forecasts.</p></li></ul>`;
        return `<ul class="recs">${a.map((x, i) => `<li class="sev${x.sev}"><b>${x.text}</b><p>${x.why}</p><button class="small" data-rec="${i}">${x.cost ? money(x.cost) : 'Do it'}</button></li>`).join('')}</ul>`;
    }
    function bindRecs(el, a) {
        el.querySelectorAll('[data-rec]').forEach(b => b.onclick = () => {
            const x = a[+b.dataset.rec];
            if (!x)
                return;
            if (x.s) {
                selId = x.s.id;
                selTrain = null;
                buildSelCard();
                const st3 = R.st3[x.s.id];
                if (st3)
                    focusOn(st3.g.localToWorld(new THREE.Vector3(0, -1, 1.5)), R.cam.r);
            }
            act(x.act);
            if (G.mode === 'normal')
                aiSnap = {
                    t: G.t,
                    a: getAdvice()
                };
            aiSig = '';
        });
    }

    // ---------- Feed + labels ----------
    function renderFeed() {
        if (G.log.length === logSig && G.log.length < 80)
            return;
        logSig = G.log.length;
        $('#feed').innerHTML = G.log.slice(-3).map(l => `<li class="${l.sev}"><time>${fmtT(l.t)}</time>${l.text}</li>`).join('');

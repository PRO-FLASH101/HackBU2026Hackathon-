    function updateLabels() {
        for (const st3 of R.st3 || []) {
            const s = st3.s,
                dl = s.danger >= 60 ? 2 : s.danger >= 35 ? 1 : 0,
                l = st3.lbl;
            l.querySelector('.dot').className = statusCls(dl);

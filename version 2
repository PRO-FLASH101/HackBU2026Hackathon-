    <script>

    // ===== ENGINE START =====
    const SIM_LEN = 600,
        BUDGET = 5000000,
        MAX_PER = 3;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const rnd = (a, b) => a + Math.random() * (b - a);
    const noise = (k) => (Math.random() - 0.5) * k;
    function curve(pts, t) {
        if (t <= pts[0][0])
            return pts[0][1];
        for (let i = 1; i < pts.length; i++) {
            if (t <= pts[i][0]) {
                const [t0, v0] = pts[i - 1],
                    [t1, v1] = pts[i];
                const k = (t - t0) / (t1 - t0);
                return v0 + (v1 - v0) * (k * k * (3 - 2 * k));
            }
        }
        return pts[pts.length - 1][1];
    }
    const pct = v => Math.round(v * 100) + '%';
    function money(n) {
        if (n < 1000)
            return '$' + Math.round(n);
        if (n >= 1e6)
            return '$' + (n / 1e6).toFixed(2).replace(/\.?0+$/, '') + 'M';
        return '$' + Math.round(n / 1000) + 'K';
    }
    const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];

    let G = null;
    const hooks = {
        log() {},
        end() {}
    };
    function log(text, sev='info', s=null) {
        G.log.push({
            t: G.t,
            text,
            sev,
            sid: s ? s.id : null
        });
        if (G.log.length > 80)
            G.log.shift();
        hooks.log();
    }
    const lineNames = s => s.lines.map(li => G.lines[li].name).join(' and ');
    const people = s => Math.round(s.occ * s.cap);

    const STD_ITEMS = [
    {
        key: 'ert',
        name: 'Emergency response team',
        cost: 150000,
        icon: '🚑',
        effect: 'Cuts passenger risk here by 15% and speeds up evacuation.'
    },
    {
        key: 'repair',
        name: 'Maintenance & repair crew',
        cost: 250000,
        icon: '🔧',
        effect: 'Restores 20% condition and clears breakdowns or signal faults.'
    },
    {
        key: 'train',
        name: 'Additional train',
        cost: 350000,
        icon: '🚆',
        effect: 'Adds 20% capacity on every line through this station.'
    },
    ];

    // ---------- City definitions ----------
    const NYC_RAIN = [[0, 25], [60, 31], [200, 50], [300, 56], [420, 52], [520, 36], [600, 28]];
    const TKY_WIND = [[0, 25], [90, 45], [200, 75], [300, 105], [360, 112], [450, 85], [540, 55], [600, 40]];
    const TKY_RAIN = [[0, 10], [120, 22], [250, 45], [340, 62], [460, 35], [600, 15]];
    const TKY_DEP = [[0, 60], [150, 115], [260, 125], [360, 95], [600, 60]];
    const LON_AMB = [[0, 29], [120, 31], [260, 34], [360, 35.5], [460, 34.5], [600, 32.5]];
    const CAI_DEM = [[0, 1], [60, 1.2], [150, 1.42], [300, 1.5], [420, 1.38], [600, 1.15]];

    const CITIES = {
        tokyo: {
            key: 'tokyo',
            name: 'Tokyo',
            system: 'Tokyo Metro',
            mission: 'Typhoon Shutdown',
            icon: '🌀',
            brief: 'A powerful typhoon is closing in. Commuters rush home as winds and rain build.',
            aiRole: 'Forecasts demand surges and recommends when to suspend or restore service.',
            baseOcc: 0.5,
            lines: [
            {
                name: 'Yamanote',
                color: '#80C241',
                loop: true,
                stops: [4, 3, 6, 2, 7, 5, 1, 0]
            },
            {
                name: 'Chuo',
                color: '#F15A22',
                stops: [0, 6, 2]
            },
            {
                name: 'Ginza',
                color: '#F39700',
                stops: [1, 7, 6, 3]
            },
            ],
            // name, x, y, size, vulnerability, exposed (above ground)
            stations: [
            ['Shinjuku', -0.8, -0.2, 1.4, 0.4, false],
            ['Shibuya', -0.6, 0.5, 1.3, 0.5, false],
            ['Tokyo', 0.7, 0.1, 1.35, 0.4, false],
            ['Ueno', 0.5, -0.65, 1.1, 0.7, true],
            ['Ikebukuro', -0.4, -0.85, 1.2, 0.4, false],
            ['Shinagawa', 0.1, 0.9, 1.1, 0.8, true],
            ['Akihabara', 0.55, -0.25, 1.0, 0.7, true],
            ['Shimbashi', 0.45, 0.55, 1.0, 0.7, true],
            ],
            item: {
                name: 'Storm protection barriers',
                cost: 200000,
                icon: '🛡️',
                effect: 'Cuts storm damage risk at this station by 25%.'
            },
            init(G) {
                G.wind = 25;
                G.rainT = 10;
                G.dep = 60;
                G.suspended = false;
            },
            tick(G, dt) {
                G.wind = Math.max(0, curve(TKY_WIND, G.t) + noise(5));
                G.rainT = Math.max(0, curve(TKY_RAIN, G.t) + noise(2));
                const depT = G.suspended ? 30 : curve(TKY_DEP, G.t);
                G.dep += (depT - G.dep) * Math.min(1, (G.suspended ? 0.02 : 0.04) * dt);
                if (!G.suspended && G.wind > 65) {
                    const k = G.wind - 65;
                    for (const s of G.st)
                        if (s.flag)
                            s.cond = Math.max(0, s.cond - k * 0.012 * Math.pow(0.75, s.item) * dt);
                    G.trainCond = Math.max(0, G.trainCond - k * 0.004 * dt);
                }
            },
            demand: G => G.dep / 60 * 0.85 + 0.15,
            hazard(G, s) {
                if (s.flag) {
                    const bf = Math.pow(0.75, s.item);
                    return (Math.max(0, G.wind - 50) * 0.9 * (G.suspended ? 0.5 : 1) + Math.max(0, G.rainT - 30) * 0.6) * bf;
                }
                return Math.max(0, G.wind - 75) * 0.35 + Math.max(0, G.rainT - 40) * 0.3;
            },
            blocks: G => G.suspended,
            penalty: G => G.suspended ? 25 : 0,
            metric: (G, s) => s.flag
            ? {
                label: 'Storm exposure',
                value: 'Above ground',
                status: G.wind >= 90 ? 2 : G.wind >= 65 ? 1 : 0
            }
            : {
                label: 'Storm exposure',
                value: 'Underground',
                status: 0
            },
            meters: G => [
            {
                icon: '💨',
                label: 'Wind gusts',
                value: Math.round(G.wind) + ' km/h',
                status: G.wind >= 90 ? 2 : G.wind >= 65 ? 1 : 0
            },
            {
                icon: '🌧️',
                label: 'Rainfall',
                value: Math.round(G.rainT) + ' mm/hr',
                status: G.rainT >= 50 ? 2 : G.rainT >= 30 ? 1 : 0
            },
            {
                icon: '🏠',
                label: 'Departure demand',
                value: Math.round(G.dep) + '%',
                status: G.dep >= 120 ? 2 : G.dep >= 100 ? 1 : 0
            },
            ],
            predict(G) {
                const out = [],
                    w60 = curve(TKY_WIND, G.t + 60),
                    w120 = curve(TKY_WIND, G.t + 120);
                out.push({
                    sev: w60 >= 90 ? 2 : w60 >= 65 ? 1 : 0,
                    text: `Wind forecast: ${Math.round(w60)} km/h in 1 min, ${Math.round(w120)} km/h in 2 min.`
                });
                let eta = null;
                for (let k = 0; k <= 300; k += 5)
                    if (curve(TKY_WIND, G.t + k) >= 90) {
                        eta = k;
                        break;
                    }
                if (eta !== null && G.wind < 90)
                    out.push({
                        sev: eta < 60 ? 2 : 1,
                        text: `Gusts pass 90 km/h (unsafe for trains) in about ${eta}s.`
                    });
                if (G.wind >= 90) {
                    let calm = null;
                    for (let k = 0; k <= 300; k += 5)
                        if (curve(TKY_WIND, G.t + k) < 70) {
                            calm = k;
                            break;
                        }
                    if (calm !== null)
                        out.push({
                            sev: 1,
                            text: `Winds drop below 70 km/h in about ${calm}s.`
                        });
                }
                const d60 = G.suspended ? 30 : curve(TKY_DEP, G.t + 60);
                out.push({
                    sev: d60 >= 120 ? 2 : d60 >= 100 ? 1 : 0,
                    text: `Departure demand heading to ${Math.round(d60)}% in 1 min.`
                });
                if (G.suspended)
                    out.push({
                        sev: 1,
                        text: `Service suspended. About ${G.st.reduce((a, s) => a + people(s), 0).toLocaleString()} people are stranded in stations.`
                    });
                return out;
            },
            advise(G) {
                const a = [],
                    w60 = curve(TKY_WIND, G.t + 60);
                if (!G.suspended && (G.wind >= 82 || w60 >= 95))
                    a.push({
                        p: 97,
                        text: 'Suspend train service now',
                        why: `Gusts reach ${Math.round(Math.max(G.wind, w60))} km/h within a minute. Trains on exposed track risk serious damage.`,
                        act: () => toggleService()
                    });
                if (G.suspended && G.wind < 72 && w60 < 72)
                    a.push({
                        p: 92,
                        text: 'Restore train service',
                        why: `Winds are easing to ${Math.round(w60)} km/h. Stranded passengers need to get home.`,
                        act: () => toggleService()
                    });
                if (!G.suspended && G.dep >= 95) {
                    const s = G.st.filter(s => !s.closed).sort((x, y) => y.occ - x.occ)[0];
                    if (s)
                        a.push({
                            p: 72,
                            s,
                            cost: 350000,
                            text: `Add a train at ${s.name}`,
                            why: `Departure demand is ${Math.round(G.dep)}%. Move people home before the storm peaks.`,
                            act: () => buy('train', s)
                        });
                }
                if (w60 >= 60)
                    for (const s of G.st)
                        if (s.flag && s.item < 2)
                            a.push({
                                p: 74 - s.item * 10,
                                s,
                                cost: 200000,
                                text: `Install storm barriers at ${s.name}`,
                                why: 'It’s an above-ground station on exposed track.',
                                act: () => buy('city', s)
                            });
                return a;
            },
            prepAdvice(G) {
                const a = [];
                for (const s of G.st)
                    if (s.flag && s.item < 1)
                        a.push({
                            p: 70,
                            s,
                            cost: 200000,
                            text: `Install storm barriers at ${s.name}`,
                            why: 'Above-ground stations take the worst wind and rain damage.',
                            act: () => buy('city', s)
                        });
                const sj = G.st[0];
                if (G.lines[0].added < 1)
                    a.push({
                        p: 60,
                        s: sj,
                        cost: 350000,
                        text: 'Add a train on the Yamanote line',
                        why: 'A rush home is coming. Extra capacity clears crowds before the storm.',
                        act: () => buy('train', sj)
                    });
                return a;
            },
            prepPredict: () => [{
                sev: 1,
                text: 'Typhoon peak expected about 6 minutes in, with gusts above 100 km/h.'
            }, {
                sev: 1,
                text: 'Above ground: Ueno, Akihabara, Shimbashi and Shinagawa.'
            }],
            controls: 'service',
        },

        nyc: {
            key: 'nyc',
            name: 'New York City',
            system: 'MTA',
            mission: 'The Underground Floods',
            icon: '🌊',
            brief: 'Heavy rain floods tunnels during rush hour, threatening stations and electrical systems.',
            aiRole: 'Predicts which stations flood next and recommends the safest rerouting.',
            baseOcc: 0.55,
            lines: [
            {
                name: '1 2 3',
                color: '#EE352E',
                stops: [7, 0, 2, 4, 6]
            },
            {
                name: '4 5 6',
                color: '#00933C',
                stops: [1, 3, 5, 6]
            },
            {
                name: 'N Q R',
                color: '#E8B800',
                stops: [0, 3, 4, 5]
            },
            ],
            stations: [
            ['Times Sq–42 St', 0, -0.5, 1.35, 0.4],
            ['Grand Central', 0.5, -0.45, 1.25, 0.35],
            ['Penn Station', -0.45, -0.2, 1.2, 0.45],
            ['Union Square', 0.15, 0.05, 1.15, 0.55],
            ['Canal St', -0.15, 0.42, 1.0, 0.8],
            ['Fulton St', 0.35, 0.68, 1.05, 0.85],
            ['South Ferry', 0.0, 0.98, 0.9, 1.0],
            ['Columbus Circle', -0.35, -0.88, 1.0, 0.25],
            ],
            item: {
                name: 'High-capacity water pumps',
                cost: 300000,
                icon: '💧',
                effect: 'Pumps floodwater out of this station and slows flooding.'
            },
            init(G) {
                G.rain = 25;
                G.drain = 40;
                for (const s of G.st) {
                    s.w = Math.random() * 3;
                    s.rate = 0;
                }
            },
            tick(G, dt) {
                G.rain = Math.max(0, curve(NYC_RAIN, G.t) + noise(2.4));
                G.drain = clamp(40 + (G.rain - 25) * 1.8, 0, 100);
                for (const s of G.st) {
                    const inflow = s.vuln * Math.max(0, G.rain - 27) * 0.0055 * (G.drain > 90 ? 1.4 : 1);
                    s.rate = inflow - (0.03 + s.item * 0.13);
                    s.w = clamp(s.w + s.rate * dt, 0, 40);
                    if (s.w >= 15)
                        s.cond = Math.max(0, s.cond - 0.25 * dt);
                }
                if (G.st.some(s => s.w >= 15))
                    G.trainCond = Math.max(0, G.trainCond - 0.01 * dt);
            },
            demand: () => 1,
            hazard: (G, s) => s.w / 15 * 60 + Math.max(0, s.w - 15) * 2,
            blocks: (G, s) => s.w >= 15,
            penalty: () => 0,
            metric: (G, s) => ({
                label: 'Water depth',
                value: s.w.toFixed(1) + ' cm',
                status: s.w >= 15 ? 2 : s.w >= 10 ? 1 : 0
            }),
            meters(G) {
                const maxW = Math.max(...G.st.map(s => s.w));

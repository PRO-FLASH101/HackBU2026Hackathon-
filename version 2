    function buildTunnels(world) {
        const nL = G.lines.length;
        R.coreMats = [];
        R.glassMats = [];
        G.lines.forEach((L, li) => {
            const raw = L.stops.map(i => new THREE.Vector3(G.st[i].x * S, TY, G.st[i].y * S));
            const off = (li - (nL - 1) / 2) * 1.15,
                n = raw.length;
            const pts = raw.map((p, k) => {
                const prev = raw[k > 0 ? k - 1 : (L.loop ? n - 1 : 0)],
                    next = raw[k < n - 1 ? k + 1 : (L.loop ? 0 : n - 1)];
                const d = next.clone().sub(prev);
                d.y = 0;
                d.normalize();
                return p.clone().add(new THREE.Vector3(-d.z, 0, d.x).multiplyScalar(off));
            });
            const curve = new THREE.CatmullRomCurve3(pts, !!L.loop, 'centripetal');
            curve.arcLengthDivisions = 600;
            L.curve = curve;
            L.wlen = curve.getLength();
            const samples = curve.getSpacedPoints(800);
            L.stopU = pts.map(p => {
                let bi = 0,
                    bd = 1e9;
                samples.forEach((q, i) => {
                    const d = q.distanceToSquared(p);
                    if (d < bd) {
                        bd = d;
                        bi = i;
                    }
                });
                return bi / 800 * L.len;
            });
            const segs = Math.max(100, Math.round(L.wlen * 2.5));
            const core = new THREE.MeshStandardMaterial({
                color: L.color,
                emissive: L.color,
                emissiveIntensity: 0.8,
                roughness: 0.5
            });
            const glass = new THREE.MeshStandardMaterial({
                color: L.color,
                transparent: true,
                opacity: 0.24,
                depthWrite: false,
                side: THREE.DoubleSide,
                roughness: 0.3
            });
            R.coreMats.push(core);
            R.glassMats.push(glass);
            const cm = new THREE.Mesh(new THREE.TubeGeometry(curve, segs, 0.3, 8, !!L.loop), core);
            world.add(cm);
            const gm = new THREE.Mesh(new THREE.TubeGeometry(curve, segs, 1.05, 14, !!L.loop), glass);
            gm.position.y = 0.5;
            gm.renderOrder = 5;
            world.add(gm);
        });
    }


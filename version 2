    function isWater(x, z) {
        const W = WATER[G.city.key];
        for (const r of W.rects || [])
            if (x >= r[0] * S && x <= r[1] * S && z >= r[2] * S && z <= r[3] * S)
                return true;
        for (const rv of R.rivers || [])
            for (const p of rv.samples)
                if (Math.hypot(p.x - x, p.z - z) < rv.w / 2 + 1.2)
                    return true;
        return false;
    }
    function ribbon(points, w, y) {
        const pos = [],
            idx = [],
            n = points.length;
        for (let i = 0; i < n; i++) {
            const a = points[Math.max(0, i - 1)],
                b = points[Math.min(n - 1, i + 1)];
            let dx = b.x - a.x,
                dz = b.z - a.z;
            const d = Math.hypot(dx, dz) || 1;
            dx /= d;
            dz /= d;
            const p = points[i];
            pos.push(p.x - dz * w / 2, y, p.z + dx * w / 2, p.x + dz * w / 2, y, p.z - dx * w / 2);
            if (i < n - 1) {
                const k = i * 2;
                idx.push(k, k + 1, k + 2, k + 1, k + 3, k + 2);
            }
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
        g.setIndex(idx);
        g.computeVertexNormals();
        return g;
    }


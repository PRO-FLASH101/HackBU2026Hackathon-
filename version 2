        const next = G.won && G.stars < 3 ? nextTip() : '';
        openModal(`<h2>${title}</h2><p class="sub">${sub}</p><div class="bigstars" aria-label="${G.stars} of 3 stars">${stars}</div>
            <table class="results">
              <tr><td>Highest disaster level</td><td>${Math.round(G.maxDisaster)}%</td></tr>
              <tr><td>Passengers kept safe (average)</td><td>${Math.round(G.safeAvg)}%</td></tr>
              <tr><td>Network performance (average)</td><td>${Math.round(G.perfAvg)}%</td></tr>
              <tr><td>Money spent</td><td>${money(G.spent)}</td></tr>
              <tr><td>AI support</td><td>${MODES.find(m => m.key === G.mode).name}</td></tr>
            </table>${next ? `<p class="note">${next}</p>` : ''}
            <div class="row-btns"><button class="primary" id="mRetry">Play again</button><button class="secondary" id="mMenu">Choose another city</button></div>`);
        $('#mRetry').onclick = () => {
            closeModal();
            startGame();
        };
        $('#mMenu').onclick = () => {
            closeModal();
            toMenu('pick');
        };
    }
    function nextTip() {
        const need = G.stars >= 2 ? [60, 90, 85] : [80, 60, 60],
            miss = [];
        if (G.maxDisaster >= need[0])
            miss.push(`keep the disaster level below ${need[0]}%`);
        if (G.safeAvg < need[1])
            miss.push(`keep at least ${need[1]}% of passengers safe`);
        if (G.perfAvg < need[2])
            miss.push(`hold network performance at ${need[2]}% or more`);
        return miss.length ? `For ${G.stars + 1} stars, ${miss.join(', ')}.` : '';
    }

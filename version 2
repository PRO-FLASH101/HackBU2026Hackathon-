            l.classList.toggle('closed', s.closed);
        }
    }

    // ---------- HUD ----------
    function refreshUI() {
        if (!G)
            return;
        updateLabels();
        if (!inGame)
            return;
        $('#gTime').textContent = fmtClock(G.t);
        $('#gMoney').textContent = money(G.money);
        const d = G.disaster,
            fill = $('#dFill');
        fill.style.width = d + '%';
        fill.style.background = d >= 80 ? 'var(--bad)' : d >= 60 ? 'var(--warn)' : 'var(--ok)';
        $('#dPeak').style.left = `calc(${G.maxDisaster}% - 1px)`;
        $('#dVal').textContent = Math.round(d) + '%';
        $('#eVal').textContent = Math.round(G.endangered) + '%';
        $('#pVal').textContent = Math.round(G.perf) + '%';
        const res = G.money / BUDGET * 100,
            safe = 100 - G.endangered;
        [[Math.round(G.occAvg) + '%', G.occAvg >= 100 ? 2 : G.occAvg >= 85 ? 1 : 0],
        [Math.round(G.trainCond) + '/100', G.trainCond < 30 ? 2 : G.trainCond < 60 ? 1 : 0],
        [Math.round(G.reliability) + '%', G.reliability < 50 ? 2 : G.reliability < 75 ? 1 : 0],
        [Math.round(res) + '%', res < 15 ? 2 : res < 40 ? 1 : 0],
        [Math.round(safe) + '/100', safe < 50 ? 2 : safe < 75 ? 1 : 0]].forEach(([v, s], i) => {
            $('#um' + i).textContent = v;
            $('#um' + i + 'd').className = statusCls(s);
        });
        G.city.meters(G).forEach((m, i) => {
            $('#cm' + i).textContent = m.value;
            $('#cm' + i + 'd').className = statusCls(m.status);
        });
        document.querySelectorAll('#speedBtns [data-speed]').forEach(b => {
            const v = +b.dataset.speed;
            b.disabled = G.phase !== 'run';
            b.setAttribute('aria-pressed', v === 0 ? G.paused : (!G.paused && G.speed === v));
        });
        $('#btnPause').textContent = G.paused ? '▶' : '❚❚';
        $('#btnPause').setAttribute('aria-label', G.paused ? 'Resume' : 'Pause');
        $('#pausedTag').classList.toggle('hidden', !(G.paused && G.phase === 'run'));

    function updateSelCard() {
        const C = G.city;
        if (selTrain) {
            const {L, tr} = selTrain;
            if (!$('#tStatus'))
                return;
            let st;
            if (L.blocked) {
                const b = L.stops.map(i => G.st[i]).find(s => s.issue === 'breakdown' || C.blocks(G, s));
                st = C.key === 'tokyo' && G.suspended ? 'Held: service suspended' : `Held: line blocked${b ? ' at ' + b.name : ''}`;
            }
            else if (tr.wait > 0 && tr.last !== undefined)
                st = `Boarding at ${G.st[L.stops[tr.last]].name}`;
            else {
                const ord = L.stopU.map((u, k) => ({
                    k,
                    d: tr.dir > 0 ? ((u - tr.u) + L.len) % L.len : ((tr.u - u) + L.len) % L.len
                })).filter(x => x.d > 0.001).sort((a, b) => a.d - b.d)[0];
                st = ord ? `Heading to ${G.st[L.stops[ord.k]].name}` : 'Moving';
            }
            $('#tStatus').textContent = st;
            $('#tLoad').textContent = `about ${tr.load.toLocaleString()}`;
            $('#tNote').textContent = L.slow ? 'A signal fault is slowing this line.' : `This line runs ${L.trains.length} trains (${L.added} extra).`;
            $('#tFollow').textContent = R.follow === tr ? 'Stop following' : 'Follow with camera';
            return;
        }
        const s = selId === null ? null : G.st[selId];
        if (!s || !$('#sOcc'))
            return;
        const m = C.metric(G, s),
            dst = s.danger >= 60 ? 2 : s.danger >= 35 ? 1 : 0;
        const st = $('#sState');
        st.textContent = s.closed ? 'Closed' : 'Open';
        st.className = 'pill' + (s.closed ? ' closed' : '');
        $('#sOccL').textContent = `Crowd (${people(s).toLocaleString()} people)`;
        $('#sOcc').innerHTML = `<span class="${statusCls(s.occ >= 1 ? 2 : s.occ >= 0.85 ? 1 : 0)}"></span>${pct(s.occ)}`;
        $('#sDanger').innerHTML = `<span class="${statusCls(dst)}"></span>${['Low', 'Elevated', 'High'][dst]} (${Math.round(s.danger)})`;
        $('#sMetricL').textContent = m.label;
        $('#sMetric').innerHTML = `<span class="${statusCls(m.status)}"></span>${m.value}`;
        $('#sCond').innerHTML = `<span class="${statusCls(s.cond < 30 ? 2 : s.cond < 60 ? 1 : 0)}"></span>${Math.round(s.cond)}%`;
        const iss = $('#sIssue');
        if (s.issue) {
            iss.className = 'note bad';
            iss.textContent = s.issue === 'breakdown' ? '⚠ Train breakdown blocking the line. Send a repair crew.' : '⚠ Signal fault slowing trains. Send a repair crew.';
        }
        else if (C.blocks(G, s)) {
            iss.className = 'note bad';
            iss.textContent = C.key === 'tokyo' ? 'Service is suspended network-wide.' : C.key === 'nyc' ? 'Tracks flooded. Trains can’t pass.' : 'Tracks here are uninspected or unsafe. Trains can’t pass.';
        }
        else {
            iss.className = 'note';
            iss.textContent = `Next train carries about ${s.load.toLocaleString()} passengers.`;
        }
        const dep = [];
        if (s.ert)
            dep.push(`🚑 ×${s.ert}`);
        if (s.item)
            dep.push(`${C.item.icon} ×${s.item}`);
        const tr = s.lines.reduce((a, li) => a + G.lines[li].added, 0);
        if (tr)
            dep.push(`🚆 +${tr} on its lines`);
        $('#sDep').textContent = dep.length ? 'Deployed here: ' + dep.join('   ') : 'Nothing deployed here yet.';
        document.querySelectorAll('[data-buy]').forEach(b => {
            const e = buyCheck(b.dataset.buy, s);
            b.disabled = !!e && e.startsWith('Not enough');
            b.title = e || '';
        });
        const tg = $('#sToggle');
        tg.textContent = s.closed ? 'Reopen station' : 'Close station and evacuate';
        tg.disabled = G.phase === 'over';
    }


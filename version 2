        position: fixed;
        left: 50%;
        top: calc(130px + env(safe-area-inset-top, 0px));
        transform: translateX(-50%);
        background: var(--ink);
        color: var(--panel);
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 14px;
        max-width: min(520px, calc(100% - 24px));
        opacity: 0;
        pointer-events: none;
        transition: opacity .2s;
        z-index: 30;
        text-align: center
    }

    #toast.show {
        opacity: 1
    }

    @media (max-width: 900px) {
        .top {
            grid-template-columns: auto 1fr auto auto;
            gap: 4px 10px;
            padding: 7px 10px
        }

        .top .title span {
            display: none
        }

        .top .speed {
            grid-column: 1 / -1;
            justify-self: start
        }

        .top #btnHelp {
            display: none
        }

        .dbar {
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px 10px
        }

        .dbar .track {
            grid-column: 1 / -1;
            order: -1
        }

        .left {
            width: auto;
            right: 12px;
            display: none
        }

        .left.open {
            display: block;
            z-index: 4;
            max-height: 50%
        }

        .mtoggle {
            display: inline-block
        }

        .right {
            top: auto;
            left: 0;
            right: 0;
            bottom: 0;
            width: auto;
            max-height: 42%;
            padding: 10px 10px calc(10px + env(safe-area-inset-bottom, 0px));
            background: linear-gradient(transparent, rgba(0, 0, 0, .18) 14px)
        }

        .feed {
            display: none
        }

        .viewbar {
            bottom: auto;
            top: var(--hudTop, 120px);
            left: 12px;
            right: 12px;
            flex-wrap: wrap
        }

        .viewbar button {
            padding: 6px 10px;
            font-size: 13px
        }

        .top .stat b {
            font-size: 18px
        }

        .prep {
            bottom: calc(42% + 12px);
            flex-direction: column;
            align-items: stretch;
            gap: 8px
        }

        .menu-panel {
            padding: 18px
        }

        .cities, .modes {
            grid-template-columns: 1fr 1fr
        }

        .menu-hint {
            display: none
        }

        #menu {
            align-items: flex-start
        }
    }

    .xhint {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 4;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        transform: translateX(-50%)
    }

    .xhint span {
        background: var(--accent);
        color: var(--accent-ink);
        font-weight: 800;
        font-size: 14px;
        padding: 7px 12px;
        border-radius: 10px;
        box-shadow: var(--shadow);
        white-space: nowrap
    }

    .xhint b {
        font-size: 36px;
        font-weight: 900;
        line-height: 1;
        color: var(--accent);
        text-shadow: 0 2px 6px rgba(0, 0, 0, .35);
        animation: xbob .9s ease-in-out infinite
    }

    .xhint.up {
        flex-direction: column-reverse
    }

    .xhint.up b {
        animation-name: xbobUp
    }

    @keyframes xbob {
        0%, 100% {
            transform:translateY(0)
        }

        50% {
            transform: translateY(9px)
        }
    }

    @keyframes xbobUp {
        0%, 100% {
            transform:translateY(0)
        }

        50% {
            transform: translateY(-9px)
        }
    }

    #btnXray.hinted {
        box-shadow: 0 0 0 3px var(--accent), var(--shadow)
    }

    #hud.hinting .feed {
        bottom: 128px
    }

    .xhint b {
        -webkit-text-stroke: 1.5px #fff
    }

    @media (prefers-reduced-motion: reduce) {
        .track .fill {
            transition:none
        }

        .xhint b {
            animation: none
        }

    function placeTrain(m) {
        const {L, tr, cars} = m,
            sp = 2.42 / L.wlen;
        let f0 = tr.u / L.len;
        cars.forEach((c, k) => {
            let f = f0 - tr.dir * k * sp;
            if (L.loop)
                f = ((f % 1) + 1) % 1;
            else
                f = clamp(f, 0, 1);
            const p = L.curve.getPointAt(f),
                tg = L.curve.getTangentAt(f);
            c.position.set(p.x, p.y + 0.62, p.z);
            c.lookAt(p.x + tg.x * tr.dir, p.y + 0.62, p.z + tg.z * tr.dir);
        });
    }


    function hintSeen() {
        try {
            return localStorage.getItem('mc-xray-hint') === '1';
        } catch (e) {
            return !!window._mcHint;
        }
    }
    function showHint(on) {
        $('#xHint').classList.toggle('hidden', !on);
        $('#btnXray').classList.toggle('hinted', on);
        $('#hud').classList.toggle('hinting', on);
        if (on)
            requestAnimationFrame(positionHint);
    }
    function positionHint() {
        const h = $('#xHint');
        if (h.classList.contains('hidden'))
            return;
        const r = $('#btnXray').getBoundingClientRect(),
            up = r.top < innerHeight / 2;
        h.classList.toggle('up', up);
        h.querySelector('b').textContent = up ? '↑' : '↓';
        const center = r.left + r.width / 2,
            left = clamp(center, h.offsetWidth / 2 + 8, innerWidth - h.offsetWidth / 2 - 8);
        h.style.left = left + 'px';
        h.querySelector('b').style.marginLeft = (2 * (center - left)) + 'px';
        h.style.top = (up ? r.bottom + 6 : r.top - h.offsetHeight - 6) + 'px';
    }
    addEventListener('resize', positionHint);
    function toggleXray() {
        setXray(!R.xray);
        if (R.xray && !$('#xHint').classList.contains('hidden')) {
            showHint(false);
            try {
                localStorage.setItem('mc-xray-hint', '1');
            } catch (e) {
                window._mcHint = true;
            }
        }
    }
    $('#btnXray').onclick = toggleXray;
    $('#btnReset').onclick = resetCamera;
    $('#btnHelp').onclick = showHelp;
    $('#btnAdmin').onclick = openAdmin;
    $('#btnMeters').onclick = () => $('#meterPanel').classList.toggle('open');
    const keys = new Set();
    document.addEventListener('keydown', e => {
        if (!$('#modal').classList.contains('hidden') || e.target.tagName === 'INPUT')
            return;
        const k = e.key.toLowerCase();
        if (inGame && e.code === 'Space') {
            e.preventDefault();
            setSpeed(0);
        }
        else if (inGame && ['1', '2', '3', '4'].includes(k))
            setSpeed(+k);
        else if (k === 'x' && inGame)
            toggleXray();
        else if (k === 'c')
            resetCamera();
        else if (k === 'escape' && !inGame)
            showScreen('title');
        else if (k === 'escape') {
            R.follow = null;
            selId = null;
            selTrain = null;
            if (inGame)
                buildSelCard();
        }
        else
            keys.add(k);
    });
    document.addEventListener('keyup', e => keys.delete(e.key.toLowerCase()));
    function keyCamera(dt) {
        if (!keys.size)
            return;
        const p = 260 * dt;
        if (keys.has('w') || keys.has('arrowup'))
            pan(0, p);
        if (keys.has('s') || keys.has('arrowdown'))
            pan(0, -p);
        if (keys.has('a') || keys.has('arrowleft'))
            pan(p, 0);
        if (keys.has('d') || keys.has('arrowright'))
            pan(-p, 0);
        if (keys.has('q'))
            R.cam.theta += dt * 1.2;
        if (keys.has('e'))
            R.cam.theta -= dt * 1.2;
        if (keys.size) {
            R.follow = null;
            R.cam.goal = null;
        }
    }
    function frame(now) {
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        if (G) {
            if (inGame)
                step(dt);
            keyCamera(dt);
            visuals(dt);
            R.renderer.render(R.scene, R.camera);
            uiTimer += dt;
            if (uiTimer > 0.25) {
                uiTimer = 0;
                refreshUI();
            }
        }
        requestAnimationFrame(frame);
    }
    function boot() {
        if (typeof THREE === 'undefined') {
            document.body.innerHTML = '<p style="padding:24px;font:16px system-ui">The 3D engine couldn’t load. Check your connection and reload the page.</p>';
            return;
        }
        init3D();
        buildMenu();
        preview();
        requestAnimationFrame(frame);
    }
    boot();
    </script>
</body>

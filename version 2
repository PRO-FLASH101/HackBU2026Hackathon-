<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Metro Crisis 3D</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
    :root {
        --panel: #FFFFFF;
        --soft: #EEF2F6;
        --ink: #15212C;
        --muted: #5A6A79;
        --rule: #D3DCE5;
        --accent: #1C5D99;
        --accent-ink: #FFFFFF;
        --ok: #1C9A57;
        --warn: #C98900;
        --bad: #D52A3F;
        --shadow: 0 8px 28px rgba(10, 20, 35, .22);
        color-scheme: light;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
            --panel: #152230;
            --soft: #1C2B3B;
            --ink: #E5ECF2;
            --muted: #98A9BA;
            --rule: #2C3E52;
            --accent: #5BA3E8;
            --accent-ink: #08131D;
            --ok: #3CC47C;
            --warn: #F0B62C;
            --bad: #FF5B6C;
            --shadow: 0 8px 28px rgba(0, 0, 0, .45);
            color-scheme: dark;
        }
    }

    :root[data-theme="dark"] {
        --panel: #152230;
        --soft: #1C2B3B;
        --ink: #E5ECF2;
        --muted: #98A9BA;
        --rule: #2C3E52;
        --accent: #5BA3E8;
        --accent-ink: #08131D;
        --ok: #3CC47C;
        --warn: #F0B62C;
        --bad: #FF5B6C;
        --shadow: 0 8px 28px rgba(0, 0, 0, .45);
        color-scheme: dark;
    }

    html {
        height: 100%;
        scroll-padding-top: env(safe-area-inset-top, 0px)
    }

    *, *::before, *::after {
        box-sizing: border-box
    }

    body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #8fa3b5;
        color: var(--ink);
        font-family: "Overpass", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 15px;
        line-height: 1.4
    }

    button {
        font: inherit;
        color: inherit;
        cursor: pointer
    }

    button:focus-visible, input:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px
    }

    .hidden {
        display: none !important
    }

    #c3d {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none;
        cursor: grab
    }

    #c3d.dragging {
        cursor: grabbing
    }

    .panel {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 14px;
        box-shadow: var(--shadow)
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex: none;
        background: var(--ok);
        display: inline-block
    }

    .dot.s1 {
        background:var(--warn)
    }

    .dot.s2 {
        background: var(--bad)
    }

    .primary {
        background: var(--accent);
        color: var(--accent-ink);
        border: 0;
        border-radius: 12px;
        padding: 13px 24px;
        font-weight: 800;
        font-size: 16px
    }

    .secondary {
        background: var(--soft);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 9px 14px;
        font-weight: 700
    }

    .secondary[aria-pressed="true"] {
        background: var(--accent);
        color: var(--accent-ink);
        border-color: var(--accent)
    }

    .ghost {
        background: none;
        border: 0;
        color: var(--muted);
        padding: 6px 8px;
        border-radius: 8px;
        font-weight: 700
    }

    .ghost:hover {
        color: var(--ink)
    }

    .small {
        padding: 6px 11px;
        font-size: 13.5px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--accent-ink);
        border: 0;
        font-weight: 800
    }

    .sub {
        color: var(--muted);
        font-size: 13.5px;
        margin: 0
    }

    .chip {
        font-size: 12px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        color: #fff;
        text-shadow: 0 0 2px rgba(0, 0, 0, .5)
    }

    .chips {
        display: flex;
        gap: 5px;
        flex-wrap: wrap
    }/* ---------- station labels in 3D ---------- */
    #labels {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 2
    }

    .lbl {
        position: absolute;
        left: 0;
        top: 0;
        transform: translate(-50%, -100%);
        pointer-events: auto;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        background: var(--panel);
        color: var(--ink);
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 2px 9px 1px 6px;
        font-size: 12.5px;
        font-weight: 800;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .18)
    }

    .lbl small {
        font-weight: 600;
        color: var(--muted);
        font-variant-numeric: tabular-nums
    }

    .lbl.sel {
        background: var(--accent);
        color: var(--accent-ink);
        border-color: var(--accent)
    }

    .lbl.sel small {
        color: var(--accent-ink)
    }

    .lbl.closed {
        opacity: .8
    }

    .lbl .warn-ic {
        color: var(--bad)
    }/* ---------- Menu ---------- */
    #menu {
        position: fixed;
        inset: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        padding: 20px;
        pointer-events: none
    }

    .menu-panel {
        pointer-events: auto;
        width: min(540px, 100%);
        max-height: 100%;
        overflow: auto;
        padding: 20px 22px 18px
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px
    }

    .brand h1 {
        font-size: clamp(38px, 6vw, 56px);
        line-height: .9;
        font-weight: 900;
        margin: 0;
        letter-spacing: -.02em
    }

    .brand .bars {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex: 1;
        max-width: 120px
    }

    .brand .bars i {
        display: block;
        height: 6px;
        border-radius: 3px
    }

    .tag {
        color: var(--muted);
        margin: 8px 0 2px;
        font-size: 15px
    }

    .menu-panel h2 {
        font-size: 17px;
        margin: 10px 0 8px;
        font-weight: 800
    }

    .cities {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px
    }

    .cityBtn {
        background: var(--soft);
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 0;
        text-align: left;
        overflow: hidden
    }

    .cityBtn .stripes {
        display: flex;
        height:6px
    }

    .cityBtn .stripes i {
        flex: 1
    }

    .cityBtn .in {
        display: block;
        padding: 8px 11px 10px
    }

    .cityBtn b {
        display: block;
        font-size: 15px;
        font-weight: 800
    }

    .cityBtn span.m {
        display: block;
        color: var(--muted);
        font-size: 13px
    }

    .cityBtn[aria-pressed="true"] {
        border-color: var(--accent);
        background: var(--panel)
    }

    .modes {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px
    }

    .modeBtn {
        background: var(--soft);
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 9px 11px;
        text-align: left
    }

    .modeBtn b {
        font-size: 15px;
        font-weight: 800
    }

    .modeBtn p {
        margin: 1px 0 0;
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.25
    }

    .modeBtn[aria-pressed="true"] {
        border-color: var(--accent);
        background: var(--panel)
    }

    .go {
        margin-top: 14px;
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap
    }

    .menu-hint {
        position: fixed;
        right: 20px;
        bottom: calc(16px + env(safe-area-inset-bottom, 0px));
        margin: 0;
        color: #fff;
        font-weight: 700;
        font-size: 13.5px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, .6);
        pointer-events: none
    }

    .brief-box {
        margin-top: 8px;
        font-size: 13.5px !important;
        background: var(--soft);
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 14px
    }

    .brief-box b {
        display: block
    }

    .title-screen {
        pointer-events: auto;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        text-align: center
    }

    #menu.on-title {
        background: radial-gradient(ellipse at center, rgba(8, 16, 26, .55) 0%, rgba(8, 16, 26, .25) 45%, transparent 75%)
    }

    .title-screen h1 {
        margin: 0;
        font-size: clamp(54px, 11vw, 150px);
        font-weight: 900;
        line-height: .9;
        letter-spacing: -.02em;
        color: #fff;
        text-shadow: 0 4px 30px rgba(0, 0, 0, .45), 0 2px 4px rgba(0, 0, 0, .35)
    }

    .title-btns {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center
    }

    .big {
        font-size: 17px;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 800;
        box-shadow: var(--shadow)
    }

    .secondary.big {
        background: var(--panel)
    }

    .about p {
        max-width: 62ch
    }/* ---------- HUD ---------- */
    #hud {
        position: fixed;
        inset: 0;
        z-index: 3;
        pointer-events: none
    }

    #hud > * {
        pointer-events: auto
    }

    .top {
        position: absolute;
        left: 12px;
        right: 12px;
        top: calc(10px + env(safe-area-inset-top, 0px));
        padding: 8px 12px;
        display: grid;
        grid-template-columns: auto 1fr auto auto auto;
        gap: 6px 16px;
        align-items: center
    }

    .top .title strong {
        display: block;
        font-size: 17px;
        font-weight: 900;
        line-height: 1.1
    }

    .top .title span {
        color: var(--muted);
        font-size: 13px
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        line-height: 1.05
    }

    .stat b {
        font-size: 21px;
        font-weight: 900;
        font-variant-numeric: tabular-nums
    }

    .stat small {
        color: var(--muted);
        font-size: 11.5px
    }

    .speed {
        display: flex;
        background: var(--soft);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 3px
    }

    .speed button {
        border: 0;
        background: none;
        padding: 6px 9px;
        border-radius: 7px;
        font-weight: 800;
        font-variant-numeric: tabular-nums
    }

    .speed button[aria-pressed="true"] {
        background: var(--accent);
        color: var(--accent-ink)
    }

    .speed button:disabled {
        opacity: .4;
        cursor: not-allowed
    }

    .dbar {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        gap: 14px;
        align-items: center;
        border-top: 1px solid var(--rule);
        padding-top: 7px
    }

    .dbar .lab {
        font-size: 13px;
        color: var(--muted);
        white-space: nowrap
    }

    .dbar .lab b {
        color: var(--ink);
        font-size: 16px;
        font-variant-numeric: tabular-nums
    }

    .track {
        position: relative;
        height: 13px;
        background: var(--soft);
        border: 1px solid var(--rule);
        border-radius: 8px;
        overflow: hidden
    }

    .track .fill {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0;
        background: var(--ok);
        transition: width .3s linear, background .3s
    }

    .track .peak {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--ink);
        opacity: .55
    }

    .track .mark {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--muted);
        opacity: .6
    }

    .left {
        position: absolute;
        left: 12px;
        top: var(--hudTop, 120px);
        width: 262px;
        padding: 10px 12px;
        max-height: calc(100% - var(--hudTop, 120px) - 70px);
        overflow: auto
    }

    .left h3, .card h3 {
        margin: 0 0 6px;
        font-size: 15px;
        font-weight: 800
    }

    .mrow {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        padding: 2px 0
    }

    .mrow .v {
        margin-left: auto;
        font-weight: 800;
        font-variant-numeric: tabular-nums
    }

    .left .sep {
        border-top: 1px solid var(--rule);
        margin: 7px 0
    }

    .right {
        position: absolute;
        right: 12px;
        top: var(--hudTop, 120px);
        bottom: 12px;
        width: 344px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        padding-bottom: 2px;
        scrollbar-width: thin
    }

    .card {
        padding: 12px 14px;
        flex: none
    }

    .ai {
        border-left: 5px solid var(--accent)
    }

    .ai .head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom:4px
    }

    .ai .head h3 {
        margin: 0
    }

    .ai .mode {
        margin-left: auto;
        font-size: 12px;
        color: var(--muted);
        font-weight: 700
    }

    .recs {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 7px
    }

    .recs li {
        background: var(--soft);
        border-radius: 10px;
        padding: 8px 10px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 3px 10px;
        align-items: start
    }

    .recs li b {
        font-size: 13.5px
    }

    .recs li p {
        grid-column: 1;
        margin: 0;
        color: var(--muted);
        font-size: 12.5px
    }

    .recs li button {
        grid-row: 1 / span 2;
        grid-column: 2;
        align-self: center
    }

    .recs li.sev2 {
        box-shadow:inset 3px 0 0 var(--bad)
    }

    .recs li.sev1 {
        box-shadow: inset 3px 0 0 var(--warn)
    }

    .preds {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px
    }

    .preds li {
        display: flex;
        gap: 8px;
        align-items:flex-start
    }

    .preds .dot {
        margin-top: 4px
    }

    .st-head {
        display: flex;
        align-items: center;
        gap:8px
    }

    .st-head h3 {
        margin: 0;
        flex: 1
    }

    .pill {
        font-size: 12px;
        font-weight: 800;
        padding: 2px 9px;
        border-radius: 999px;
        background: var(--soft);
        border: 1px solid var(--rule)
    }

    .pill.closed {
        background: var(--ink);
        color: var(--panel);
        border-color: var(--ink)
    }

    .stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin: 8px 0 0
    }

    .stats div {
        background: var(--soft);
        border-radius: 10px;
        padding: 6px 9px
    }

    .stats dt {
        font-size: 11.5px;
        color: var(--muted)
    }

    .stats dd {
        margin: 0;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px
    }

    .note {
        font-size: 12.5px;
        margin: 7px 0 0;
        color: var(--muted)
    }

    .note.bad {
        color: var(--bad);
        font-weight: 700
    }

    .shop {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 9px
    }

    .buy {
        display: grid;
        grid-template-columns: 26px 1fr auto;
        gap: 1px 8px;
        align-items: center;
        text-align: left;
        background: var(--soft);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 7px 9px
    }

    .buy:hover:not(:disabled) {
        border-color: var(--accent)
    }

    .buy:disabled {
        opacity: .5;
        cursor: not-allowed
    }

    .buy .ic {
        font-size: 17px;
        grid-row: 1 / span 2;
        text-align: center
    }

    .buy b {
        font-size:13.5px
    }

    .buy .c {
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        font-size: 13.5px
    }

    .buy small {
        grid-column: 2 / span 2;
        color: var(--muted);
        font-size: 12px
    }

    .wide {
        width: 100%;
        margin-top: 9px
    }

    .seg {
        display: flex;
        background: var(--soft);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 3px;
        margin-top: 8px
    }

    .seg button {
        flex: 1;
        border: 0;
        background: none;
        padding: 7px 4px;
        border-radius: 7px;
        font-weight: 700
    }

    .seg button[aria-pressed="true"] {
        background: var(--accent);
        color: var(--accent-ink)
    }

    .feed {
        position: absolute;
        left: 12px;
        bottom: 62px;
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: min(380px, calc(100% - 400px));
        pointer-events: none !important
    }

    .feed li {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-left: 4px solid var(--muted);
        border-radius: 8px;
        padding: 4px 9px;
        font-size: 12.5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .15)
    }

    .feed li.ok {
        border-left-color:var(--ok)
    }

    .feed li.warn {
        border-left-color:var(--warn)
    }

    .feed li.bad {
        border-left-color: var(--bad)
    }

    .feed li time {
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        margin-right: 6px
    }

    .viewbar {
        position: absolute;
        left: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom, 0px));
        display: flex;
        gap: 6px
    }

    .viewbar button {
        box-shadow: var(--shadow);
        background: var(--panel)
    }

    .viewbar button[aria-pressed="true"] {
        background: var(--accent);
        color: var(--accent-ink)
    }

    .prep {
        position: absolute;
        left: 50%;
        bottom: calc(14px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        padding: 12px 14px;
        display: flex;
        gap: 14px;
        align-items: center;
        width: min(520px, calc(100% - 24px));
        border: 2px solid var(--accent)
    }

    .prep p {
        margin: 0;
        font-size: 14px
    }

    .prep .primary {
        white-space: nowrap;
        padding: 11px 18px;
        font-size: 15px
    }

    .pausedTag {
        position: absolute;
        left: 50%;
        top: var(--hudTop, 120px);
        transform: translateX(-50%);
        background: var(--ink);
        color: var(--panel);
        padding: 5px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 13px
    }

    .flash {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background: #fff;
        opacity: 0
    }

    .mtoggle {
        display: none
    }

    .modal {
        position: fixed;
        inset: 0;
        background: rgba(5, 12, 20, .55);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 20
    }

    .modal-box {
        width: min(480px, 100%);
        max-height: 100%;
        overflow: auto;
        padding: 22px
    }

    .modal-box h2 {
        margin: 0 0 4px;
        font-size: 26px;
        font-weight: 900
    }

    .modal-box ul {
        padding-left:20px
    }

    .modal-box li {
        margin: 3px 0
    }

    .bigstars {
        font-size: 44px;
        letter-spacing: 6px;
        margin: 6px 0;
        color:var(--warn)
    }

    .bigstars .off {
        color: var(--rule)
    }

    .results {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0 6px;
        font-size: 14px
    }

    .results td {
        padding: 7px 0;
        border-bottom: 1px solid var(--rule)
    }

    .results td:last-child {
        text-align: right;
        font-weight: 800;
        font-variant-numeric: tabular-nums
    }

    .row-btns {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px
    }

    .field {
        width: 100%;
        padding: 11px 12px;
        border-radius: 10px;
        border: 1px solid var(--rule);
        background: var(--soft);
        color: var(--ink);

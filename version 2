                    value: Math.round(po) + '%',
                    status: po >= 95 ? 2 : po >= 85 ? 1 : 0
                },
                {
                    icon: '🚇',
                    label: 'Train capacity use',
                    value: Math.round(G.util) + '%',
                    status: G.util >= 100 ? 2 : G.util >= 95 ? 1 : 0
                },
                {
                    icon: '⏱️',
                    label: 'Average delay',
                    value: G.delay.toFixed(1) + ' min',
                    status: G.delay >= 5 ? 2 : G.delay >= 3 ? 1 : 0
                },
                ];
            },
            predict(G) {
                const out = [],
                    d60 = curve(CAI_DEM, G.t + 60);
                out.push({
                    sev: d60 >= 1.4 ? 2 : d60 >= 1.2 ? 1 : 0,
                    text: `Passenger demand: ${Math.round(d60 * 100)}% of normal in 1 min.`
                });
                const soon = G.st.filter(s => !s.closed && s.target > 0.95).sort((a, b) => b.target - a.target).slice(0, 3);
                for (const s of soon)
                    out.push({
                        sev: s.occ >= 0.95 ? 2 : 1,
                        text: s.occ >= 0.95 ? `${s.name} is overcrowded (${pct(s.occ)}) and spilling into neighbours.` : `${s.name} heading to ${pct(s.target)} crowding.`,
                        s
                    });
                if (G.delay >= 3)
                    out.push({
                        sev: G.delay >= 5 ? 2 : 1,
                        text: `Delays averaging ${G.delay.toFixed(1)} min and rising with train load.`
                    });
                return out;
            },
            advise(G) {
                const a = [];
                for (const s of G.st) {
                    if (!s.closed && (s.target >= 0.92 || s.occ >= 0.9) && s.item < MAX_PER)
                        a.push({
                            p: 60 + (Math.max(s.occ, s.target) - 0.9) * 120,
                            s,
                            cost: 120000,
                            text: `Deploy crowd control at ${s.name}`,
                            why: `Platform heading to ${pct(Math.max(s.occ, s.target))}. Redirect passengers to quieter stations.`,
                            act: () => buy('city', s)
                        });
                    if (!s.closed && s.occ >= 1.1 && s.item >= MAX_PER)
                        a.push({
                            p: 80,
                            s,
                            text: `Close entry at ${s.name}`,
                            why: `It’s at ${pct(s.occ)} even with crowd control. Stop new arrivals.`,
                            act: () => toggleStation(s)
                        });
                    if (s.closed && s.target < 0.85)
                        a.push({
                            p: 50,
                            s,
                            text: `Reopen ${s.name}`,
                            why: 'Crowds nearby have eased.',
                            act: () => toggleStation(s)
                        });
                }
                if (G.dem > 1.25 && G.freq !== 'high')
                    a.push({
                        p: 78,
                        text: 'Set train frequency to high',
                        why: `Demand is ${Math.round(G.dem * 100)}% of normal. More frequent trains cut crowding and delays.`,
                        act: () => setFreq('high')
                    });
                const busy = G.lines.filter(L => L.added < MAX_PER).map(L => ({
                    L,
                    o: L.stops.reduce((x, i) => x + G.st[i].occ, 0) / L.stops.length
                })).sort((x, y) => y.o - x.o)[0];
                if (busy && busy.o > 0.85) {
                    const s = G.st[busy.L.stops[0]];
                    a.push({
                        p: 65 + (busy.o - 0.85) * 100,
                        s,
                        cost: 350000,
                        text: `Add a train on ${busy.L.name}`,
                        why: `${busy.L.name} platforms average ${pct(busy.o)} full.`,
                        act: () => buy('train', s)
                    });
                }
                return a;
            },
            prepAdvice(G) {
                const a = [];
                for (const i of [0, 1]) {
                    const s = G.st[i];
                    if (s.item < 1)
                        a.push({
                            p: 70,
                            s,
                            cost: 120000,
                            text: `Deploy crowd control at ${s.name}`,
                            why: 'Major transfer hub. Crowds build here first.',
                            act: () => buy('city', s)
                        });
                }
                if (G.lines[1].added < 1)
                    a.push({
                        p: 65,
                        s: G.st[6],
                        cost: 350000,
                        text: 'Add a train on Line 2',
                        why: 'Line 2 links the two busiest hubs.',
                        act: () => buy('train', G.st[6])
                    });
                return a;
            },
            prepPredict: () => [{
                sev: 1,
                text: 'Demand climbs to about 150% of normal around 5 minutes in.'
            }, {
                sev: 1,
                text: 'Busiest transfer hubs: Sadat, Al-Shohadaa, Attaba.'
            }],
            controls: 'freq',
        },
    };
    const CITY_ORDER = ['tokyo', 'nyc', 'london', 'mexico', 'cairo'];

    // ---------- Game setup ----------
    function newGame(key, mode) {
        const C = CITIES[key];
        G = {
            key,
            city: C,
            mode,
            phase: 'prep',
            t: 0,
            speed: 1,
            paused: false,
            money: BUDGET,
            trainCond: 95,
            reliability: 100,
            disaster: 0,
            maxDisaster: 0,
            endangered: 0,
            perf: 100,
            occAvg: 55,
            safeSum: 0,
            perfSum: 0,
            timeSum: 0,
            log: [],
            nextEvent: 30,
            freq: 'normal',
            won: false,
            spent: 0,
        };
        G.st = C.stations.map((d, i) => ({
            id: i,
            name: d[0],
            x: d[1],
            y: d[2],
            size: d[3],
            vuln: d[4],
            flag: !!d[5],
            lines: [],
            nbrs: [],
            cond: 95,
            issue: null,
            issueT: 0,
            surge: 0,
            closed: false,
            ert: 0,
            item: 0,
            danger: 0,
            occ: 0,
            target: 0,
            cap: 0,
            load: 0
        }));
        G.lines = C.lines.map((L, li) => ({
            ...L,
            idx: li,
            added: 0,
            cap: 1,
            blocked: false,
            slow: false,
            trains: []
        }));
        for (const L of G.lines) {
            L.stops.forEach((sid, k) => {
                const s = G.st[sid];
                if (!s.lines.includes(L.idx))
                    s.lines.push(L.idx);
                const nb = [];
                if (k > 0)
                    nb.push(L.stops[k - 1]);
                if (k < L.stops.length - 1)
                    nb.push(L.stops[k + 1]);
                if (L.loop && k === 0)
                    nb.push(L.stops[L.stops.length - 1]);
                if (L.loop && k === L.stops.length - 1)
                    nb.push(L.stops[0]);
                for (const n of nb)
                    if (n !== sid && !s.nbrs.includes(n))
                        s.nbrs.push(n);
            });
            const pts = L.stops.map(i => [G.st[i].x, G.st[i].y]);
            if (L.loop)
                pts.push(pts[0]);
            L.pts = pts;
            L.cum = [0];
            for (let k = 1; k < pts.length; k++)
                L.cum.push(L.cum[k - 1] + Math.hypot(pts[k][0] - pts[k - 1][0], pts[k][1] - pts[k - 1][1]));
            L.len = L.cum[L.cum.length - 1];
            const n = L.loop ? 3 : 2;
            for (let k = 0; k < n; k++)
                L.trains.push({
                    u: (k + 0.35) / n * L.len,
                    dir: k % 2 ? -1 : 1
                });
        }
        for (const s of G.st) {
            s.base = (C.baseOcc || 0.55) * (s.lines.length > 1 ? 1.12 : 1) * rnd(0.9, 1.06);
            s.occ = s.base;
            s.cap = Math.round(rnd(700, 900) * s.size * s.size);
            s.load = Math.round(rnd(500, 1400));
        }
        C.init(G);
        log(`Prep phase. You have ${money(BUDGET)} to spend. Start the clock when you’re ready.`);
    }
    const freqCap = () => G.freq === 'high' ? 1.15 : G.freq === 'low' ? 0.85 : 1;

    function triggerEvent(type, target) {
        const open = G.st.filter(s => !s.closed);
        if (!open.length)
            return;
        const s = target || open[Math.floor(Math.random() * open.length)];
        if (type === 'breakdown') {
            if (s.issue)
                return;
            s.issue = 'breakdown';
            s.issueT = 150;
            G.trainCond = Math.max(0, G.trainCond - 12);
            log(`Train breakdown near ${s.name}. ${lineNames(s)} blocked.`, 'bad', s);
        }
        else if (type === 'signal') {
            if (s.issue)
                return;
            s.issue = 'signal';
            s.issueT = 150;
            log(`Signal malfunction at ${s.name}. Trains slowed on ${lineNames(s)}.`, 'warn', s);
        }
        else if (type === 'surge') {
            s.surge += 0.35;
            log(`Unexpected passenger surge at ${s.name}.`, 'warn', s);
        }
    }
    function rollEvents() {
        if (Math.random() < 0.04)
            triggerEvent('breakdown');
        if (Math.random() < 0.03)
            triggerEvent('signal');
        if (Math.random() < 0.08)
            triggerEvent('surge');
        if (G.city.event)
            G.city.event(G);
    }

    function tick(dt) {
        const C = G.city;
        G.t += dt;
        while (G.t >= G.nextEvent) {
            rollEvents();
            G.nextEvent += 30;
        }
        C.tick(G, dt);
        for (const L of G.lines) {
            L.blocked = L.stops.some(i => G.st[i].issue === 'breakdown' || C.blocks(G, G.st[i]));
            L.slow = L.stops.some(i => G.st[i].issue === 'signal');
        }
        const fc = freqCap();
        for (const s of G.st) {
            let cap = 0;
            for (const li of s.lines) {
                const L = G.lines[li];
                cap += L.cap * (L.slow ? 0.7 : 1);
            }
            cap = cap / s.lines.length * fc;
            let tgt = s.base * C.demand(G, s) + s.surge + (s.issue ? 0.12 : 0);
            tgt += s.lines.filter(li => G.lines[li].blocked).length / s.lines.length * 0.15;
            for (const n of s.nbrs) {
                const ns = G.st[n];
                if (ns.closed)
                    tgt += 0.05;
                if (ns.occ > 1)
                    tgt += (ns.occ - 1) * 0.2;
            }
            s.target = Math.max(0.05, tgt / cap - 0.22 * (C.key === 'cairo' ? s.item : 0));
            if (s.closed)
                s.occ = Math.max(0, s.occ - (0.008 + 0.012 * s.ert) * dt);
            else
                s.occ += (s.target - s.occ) * Math.min(1, 0.06 * dt);
            s.surge = Math.max(0, s.surge - 0.004 * dt);
            if (s.issue) {
                s.issueT -= dt;
                if (s.issueT <= 0) {
                    log(`${s.issue === 'breakdown' ? 'Breakdown' : 'Signal fault'} at ${s.name} cleared on its own.`, 'info', s);
                    s.issue = null;
                }
            }
        }
        let ppl = 0,
            risk = 0,
            dsum = 0,
            dmax = 0,
            openN = 0,
            occSum = 0;
        for (const s of G.st) {
            let d = C.hazard(G, s) + (s.occ > 0.85 ? (s.occ - 0.85) * 160 : 0) + (s.cond < 60 ? (60 - s.cond) * 0.8 : 0) + (s.issue ? 6 : 0) - 15 * s.ert;
            if (s.closed)
                d *= s.occ < 0.03 ? 0.35 : 0.65;
            s.danger = clamp(d, 0, 100);
            const p = s.occ * s.cap;
            ppl += p;
            risk += p * clamp((s.danger - 35) / 50, 0, 1);
            dsum += s.danger;
            dmax = Math.max(dmax, s.danger);
            if (!s.closed) {
                openN++;
                occSum += s.occ;
            }
        }
        G.endangered = ppl > 1 ? risk / ppl * 100 : 0;
        const tgtD = 0.5 * dsum / G.st.length + 0.5 * dmax;
        G.disaster = clamp(G.disaster + (tgtD - G.disaster) * Math.min(1, 0.08 * dt), 0, 100);
        const issues = G.st.filter(s => s.issue).length,
            closedFrac = 1 - openN / G.st.length,
            blockedFrac = G.lines.filter(l => l.blocked).length / G.lines.length;
        const relT = clamp(100 - 10 * issues - 40 * closedFrac - 30 * blockedFrac - C.penalty(G), 0, 100);
        G.reliability += (relT - G.reliability) * Math.min(1, 0.15 * dt);
        G.occAvg = openN ? occSum / openN * 100 : 0;
        const crowdPen = clamp((G.occAvg - 80) * 3, 0, 100);
        G.perf = 0.45 * G.reliability + 0.3 * G.trainCond + 0.25 * (100 - crowdPen) * (openN / G.st.length);
        G.timeSum += dt;
        G.safeSum += (100 - G.endangered) * dt;
        G.perfSum += G.perf * dt;
        G.maxDisaster = Math.max(G.maxDisaster, G.disaster);
        if (G.disaster >= 99.95 || G.endangered > 80)
            endGame(false);
        else if (G.t >= SIM_LEN)
            endGame(true);
    }

    function moveTrains(dt) {
        for (const L of G.lines) {
            if (L.blocked)
                continue;
            const v = 0.16 * (L.slow ? 0.4 : 1) * dt;
            for (const tr of L.trains) {
                if (tr.wait > 0) {
                    tr.wait -= dt;
                    continue;
                }
                const prev = tr.u;
                tr.u += tr.dir * v;
                if (L.loop)
                    tr.u = ((tr.u % L.len) + L.len) % L.len;
                else if (tr.u > L.len) {
                    tr.u = L.len;
                    tr.dir = -1;
                    tr.wait = 2.2;
                    arriveAt(L, tr, L.stops.length - 1);
                    continue;
                }
                else if (tr.u < 0) {
                    tr.u = 0;
                    tr.dir = 1;
                    tr.wait = 2.2;
                    arriveAt(L, tr, 0);
                    continue;
                }
                if (L.stopU && Math.abs(tr.u - prev) < L.len / 2) {
                    for (let k = 0; k < L.stopU.length; k++) {
                        const su = L.stopU[k];
                        if (k === tr.last || su === prev)
                            continue;
                        if ((su - prev) * (tr.u - su) >= 0) {
                            tr.u = su;
                            tr.wait = 1.6;
                            arriveAt(L, tr, k);
                            break;
                        }
                    }
                }
            }
        }
    }
    function arriveAt(L, tr, k) {
        tr.last = k;
        const s = G.st[L.stops[k]];
        tr.load = Math.round(clamp(s.occ, 0.15, 1.3) * rnd(600, 1250));
    }

    function step(realDt) {
        if (G.phase !== 'run' || G.paused)
            return;
        let dt = Math.min(realDt, 0.25) * G.speed;
        while (dt > 0 && G.phase === 'run') {
            const h = Math.min(0.2, dt);
            tick(h);
            moveTrains(h);
            dt -= h;
        }
    }

    function endGame(won) {
        if (G.phase === 'over')
            return;
        G.phase = 'over';
        G.won = won;
        G.safeAvg = G.timeSum ? G.safeSum / G.timeSum : 100;
        G.perfAvg = G.timeSum ? G.perfSum / G.timeSum : 100;
        G.reason = won ? '' : (G.disaster >= 99.95 ? 'The disaster level reached 100%.' : 'More than 80% of passengers became endangered.');
        G.stars = !won ? 0
        : (G.maxDisaster < 60 && G.safeAvg >= 90 && G.perfAvg >= 85) ? 3
        : (G.maxDisaster < 80 && G.safeAvg >= 60 && G.perfAvg >= 60) ? 2
        : (G.safeAvg >= 20 && G.perfAvg >= 30) ? 1 : 0;
        hooks.end();
    }

    // ---------- Player actions (return an error message or null) ----------
    function itemFor(key) {
        return key === 'city' ? G.city.item : STD_ITEMS.find(i => i.key === key);
    }
    function buyCheck(key, s) {
        const C = G.city,
            item = itemFor(key);
        if (G.phase === 'over')
            return 'The simulation has ended.';
        if (G.money < item.cost)
            return `Not enough money. ${item.name} costs ${money(item.cost)}.`;
        if (key === 'ert' && s.ert >= MAX_PER)
            return `${s.name} already has the maximum of ${MAX_PER} response teams.`;
        if (key === 'repair' && s.cond >= 99.5 && !s.issue && G.trainCond >= 99.5)
            return `Nothing at ${s.name} needs repair.`;
        if (key === 'train') {
            if (s.closed || C.blocks(G, s))
                return `Tracks at ${s.name} are closed or unsafe. Trains can’t be deployed there.`;
            if (s.lines.every(li => G.lines[li].added >= MAX_PER))
                return `Every line through ${s.name} already runs the maximum of ${MAX_PER} extra trains.`;
        }
        if (key === 'city') {
            if (s.item >= MAX_PER)
                return `${s.name} already has the maximum of ${MAX_PER} ${item.name.toLowerCase()}.`;
            if (C.canItem) {
                const e = C.canItem(G, s);
                if (e)
                    return e;
            }
        }
        return null;
    }
    function buy(key, s) {
        const err = buyCheck(key, s);
        if (err)
            return err;
        const item = itemFor(key);
        G.money -= item.cost;
        G.spent += item.cost;
        if (key === 'ert')
            s.ert++;
        else if (key === 'repair') {
            s.cond = Math.min(100, s.cond + 20);
            G.trainCond = Math.min(100, G.trainCond + 10);
            if (s.issue) {
                log(`Repair crew cleared the ${s.issue === 'breakdown' ? 'breakdown' : 'signal fault'} at ${s.name}.`, 'ok', s);
                s.issue = null;
            }
        } else if (key === 'train') {
            for (const li of s.lines) {
                const L = G.lines[li];
                if (L.added < MAX_PER) {
                    L.added++;
                    L.cap = 1 + 0.2 * L.added;
                    L.trains.push({
                        u: Math.random() * L.len,
                        dir: Math.random() < 0.5 ? 1 : -1
                    });
                }
            }
        } else {
            s.item++;
            if (G.city.onItem)
                G.city.onItem(G, s);
        }
        log(`${item.name} deployed at ${s.name}.`, 'ok', s);
        if (hooks.bought)
            hooks.bought(key, s);
        return null;
    }
    function toggleStation(s) {
        if (G.phase === 'over')
            return 'The simulation has ended.';
        if (s.closed) {
            if (G.city.canReopen) {
                const e = G.city.canReopen(G, s);
                if (e)
                    return e;
            }
            if (G.city.key === 'nyc' && s.w >= 15)
                return `${s.name} is still flooded. It can’t reopen until the water drops below 15 cm.`;
            s.closed = false;
            log(`${s.name} reopened.`, 'ok', s);
        } else {
            s.closed = true;
            log(`${s.name} closed. Evacuating passengers.`, 'warn', s);
        }
        return null;
    }
    function toggleService() {
        if (G.city.key !== 'tokyo' || G.phase === 'over')
            return null;
        if (G.suspended) {
            if (G.wind >= 90)
                return `Gusts are ${Math.round(G.wind)} km/h. Tracks are unsafe above 90 km/h, so service can’t restart yet.`;
            G.suspended = false;
            log('Train service restored.', 'ok');
        } else {
            G.suspended = true;
            log('All train service suspended for the typhoon.', 'warn');
        }
        return null;
    }
    function setFreq(f) {
        G.freq = f;
        log(`Train frequency set to ${f}.`, 'info');
        return null;
    }
    function reopenCleared() {
        const ok = G.st.filter(s => s.closed && !(G.city.canReopen && G.city.canReopen(G, s)));
        if (!ok.length)
            return 'No closed stations are cleared to reopen yet.';
        ok.forEach(s => toggleStation(s));
        return null;
    }

    // ---------- AI co-pilot ----------
    function genericAdvice() {
        const a = [];
        for (const s of G.st) {
            if (s.issue)
                a.push({
                    p: 80,
                    s,
                    cost: 250000,
                    text: `Send a repair crew to ${s.name}`,
                    why: `A ${s.issue === 'breakdown' ? 'broken-down train is blocking' : 'signal fault is slowing'} the ${lineNames(s)} line${s.lines.length > 1 ? 's' : ''}.`,
                    act: () => buy('repair', s)
                });
            if (!s.closed && s.occ > 0.95 && G.city.key !== 'cairo' && !buyCheck('train', s))
                a.push({
                    p: 55 + (s.occ - 0.95) * 100,
                    s,
                    cost: 350000,
                    text: `Add a train through ${s.name}`,
                    why: `The platform is ${pct(s.occ)} full. More trains move people out faster.`,
                    act: () => buy('train', s)
                });
            if (!s.closed && s.occ >= 1.05 && s.danger >= 45 && G.city.key !== 'tokyo')
                a.push({
                    p: 70 + s.danger / 5,
                    s,
                    text: `Close entry at ${s.name}`,
                    why: `It’s ${pct(s.occ)} full and getting dangerous. Stop new arrivals and let it clear.`,
                    act: () => toggleStation(s)
                });
            if (s.danger >= 50 && s.ert < MAX_PER && s.occ > 0.15)
                a.push({
                    p: s.danger,
                    s,
                    cost: 150000,
                    text: `Send an emergency response team to ${s.name}`,
                    why: `About ${people(s).toLocaleString()} people here face ${s.danger >= 70 ? 'serious' : 'rising'} danger.`,
                    act: () => buy('ert', s)
                });
        }
        if (G.trainCond < 60) {
            const s = [...G.st].sort((x, y) => x.cond - y.cond)[0];
            a.push({
                p: 66,
                s,
                cost: 250000,
                text: `Send a repair crew to ${s.name}`,
                why: `Fleet condition is ${Math.round(G.trainCond)}/100. Repairs prevent more breakdowns.`,
                act: () => buy('repair', s)
            });
        }
        return a;
    }
    function getAdvice() {
        const C = G.city;
        let a = G.phase === 'prep' ? C.prepAdvice(G) : [...C.advise(G), ...genericAdvice()];
        a = a.filter(x => !x.cost || (x.cost <= G.money && (x.p >= 75 || G.money - x.cost >= 600000)));
        const seen = new Set(),
            out = [];
        for (const x of a.sort((p, q) => q.p - p.p)) {
            if (seen.has(x.text))
                continue;
            seen.add(x.text);
            x.sev = x.p >= 80 ? 2 : x.p >= 60 ? 1 : 0;
            out.push(x);
            if (out.length >= 3)
                break;
        }
        return out;
    }
    function getPredictions() {
        const C = G.city;
        const out = G.phase === 'prep' ? C.prepPredict(G) : C.predict(G);
        if (G.phase !== 'prep') {
            for (const L of G.lines)
                if (L.blocked && C.key !== 'tokyo') {
                    const sb = L.stops.map(i => G.st[i]).find(s => s.issue === 'breakdown' || C.blocks(G, s));
                    if (sb)
                        out.push({
                            sev: 2,
                            text: `${L.name} is blocked at ${sb.name}. Passengers are building up along the line.`
                        });
                }
            const hot = G.st.filter(s => s.danger >= 60);
            if (hot.length)
                out.push({
                    sev: 2,
                    text: `High danger now: ${hot.map(s => s.name).join(', ')}.`
                });
        }
        return out.slice(0, 5);
    }
